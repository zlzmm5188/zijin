# Providence Financial Platform - Environment Variables
# Copy this file to .env and fill in your values

# ==============================================
# DATABASE CONFIGURATION (Railway)
# ==============================================
# When using Railway's MySQL add-on, these values are automatically provided.
# You can reference Railway's variables directly:
#   DB_HOST=${MYSQLHOST} or mysql.railway.internal
#   DB_PORT=${MYSQLPORT}
#   DB_DATABASE=${MYSQLDATABASE}
#   DB_USERNAME=${MYSQLUSER}
#   DB_PASSWORD=${MYSQLPASSWORD}
# If not using Railway's MySQL add-on, set these manually.
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_DATABASE=providence
DB_USERNAME=root
DB_PASSWORD=your-database-password
DB_CHARSET=utf8mb4
DB_PREFIX=

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# ==============================================
# JWT AUTHENTICATION
# ==============================================
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRY=86400

# ==============================================
# TELEGRAM BOT NOTIFICATIONS (Optional)
# ==============================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ==============================================
# TRONGRID API (Optional - for USDT payments)
# ==============================================
TRONGRID_API_KEY=your-trongrid-api-key
TRON_WALLET_ADDRESS=your-tron-wallet-address

# ==============================================
# EMAIL CONFIGURATION (Optional)
# ==============================================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Providence

# ==============================================
# OPENAI/GPT CONFIGURATION (Optional - for AI features)
# ==============================================
OPENAI_API_KEY=your-openai-api-key

# ==============================================
# CORS ALLOWED ORIGINS (comma-separated)
# ==============================================
CORS_ORIGINS=https://your-frontend-domain.com
