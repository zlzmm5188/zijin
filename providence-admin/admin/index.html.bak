<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>PROVIDENCE 管理后台</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.staticfile.org/layui/2.8.18/css/layui.css">
    <style>
        .layui-header {
            background-color: #2c3e50;
        }
        .layui-header .layui-logo {
            color: #fff;
            font-size: 18px;
            font-weight: bold;
        }
        .layui-side {
            background-color: #2c3e50;
        }
        .layui-side-scroll {
            background-color: #2c3e50;
        }
        .layui-nav-tree {
            background-color: #2c3e50;
        }
    </style>
</head>
<body>
    <div class="layui-layout layui-layout-admin">
        <!-- 头部 -->
        <div class="layui-header">
            <div class="layui-logo layui-hide-xs">PROVIDENCE 管理系统</div>
            <ul class="layui-nav layui-layout-right">
                <li class="layui-nav-item layui-hide layui-show-sm-inline-block">
                    <a href="javascript:;">
                        <i class="layui-icon layui-icon-username"></i>
                        <span id="admin-username">管理员</span>
                    </a>
                    <dl class="layui-nav-child">
                        <dd><a href="javascript:;" id="logout">退出登录</a></dd>
                    </dl>
                </li>
            </ul>
        </div>

        <!-- 左侧导航 -->
        <div class="layui-side layui-bg-black">
            <div class="layui-side-scroll">
                <ul class="layui-nav layui-nav-tree" lay-filter="nav">
                    <li class="layui-nav-item layui-nav-itemed">
                        <a href="javascript:;"><i class="layui-icon layui-icon-home"></i> 首页</a>
                        <dl class="layui-nav-child">
                            <dd><a href="dashboard.html" target="content">数据概览</a></dd>
                        </dl>
                    </li>
                    
                    <li class="layui-nav-item">
                        <a href="javascript:;"><i class="layui-icon layui-icon-user"></i> 用户管理</a>
                        <dl class="layui-nav-child">
                            <dd><a href="users.html" target="content">用户列表</a></dd>
                            <dd><a href="vip.html" target="content">VIP等级</a></dd>
                        </dl>
                    </li>
                    
                    <li class="layui-nav-item">
                        <a href="javascript:;"><i class="layui-icon layui-icon-app"></i> 项目管理</a>
                        <dl class="layui-nav-child">
                            <dd><a href="projects.html" target="content">项目列表</a></dd>
                            <dd><a href="managers.html" target="content">项目经理</a></dd>
                            <dd><a href="orders.html" target="content">投资订单</a></dd>
                        </dl>
                    </li>
                    
                    <li class="layui-nav-item">
                        <a href="javascript:;"><i class="layui-icon layui-icon-rmb"></i> 财务管理</a>
                        <dl class="layui-nav-child">
                            <dd><a href="recharge.html" target="content">充值审核</a></dd>
                            <dd><a href="withdraw.html" target="content">提现审核</a></dd>
                            <dd><a href="balance.html" target="content">资金流水</a></dd>
                        </dl>
                    </li>
                    
                    <li class="layui-nav-item">
                        <a href="javascript:;"><i class="layui-icon layui-icon-file"></i> 内容管理</a>
                        <dl class="layui-nav-child">
                            <dd><a href="news.html" target="content">新闻快讯</a></dd>
                            <dd><a href="company-news.html" target="content">公司动态</a></dd>
                            <dd><a href="education.html" target="content">投资课堂</a></dd>
                        </dl>
                    </li>
                    
                    <li class="layui-nav-item">
                        <a href="javascript:;"><i class="layui-icon layui-icon-chart"></i> 数据统计</a>
                        <dl class="layui-nav-child">
                            <dd><a href="stats.html" target="content">统计报表</a></dd>
                        </dl>
                    </li>
                    
                    <li class="layui-nav-item">
                        <a href="javascript:;"><i class="layui-icon layui-icon-set"></i> 系统设置</a>
                        <dl class="layui-nav-child">
                            <dd><a href="config.html" target="content">系统配置</a></dd>
                            <dd><a href="admins.html" target="content">管理员</a></dd>
                        </dl>
                    </li>
                </ul>
            </div>
        </div>

        <!-- 主体内容 -->
        <div class="layui-body" style="background: #f2f2f2;">
            <iframe name="content" src="dashboard.html" frameborder="0" style="width: 100%; height: 100%;"></iframe>
        </div>

        <!-- 底部 -->
        <div class="layui-footer">
            © 2024 PROVIDENCE - Powered by PHP
        </div>
    </div>

    <script src="https://cdn.staticfile.org/layui/2.8.18/layui.js"></script>
    <script>
    // 检查登录状态
    if(!localStorage.getItem('admin_token')){
        location.href = 'login.html';
    }
    
    // 显示用户名
    document.getElementById('admin-username').textContent = localStorage.getItem('admin_user') || '管理员';
    
    layui.use(['element', 'layer'], function(){
        var element = layui.element;
        var layer = layui.layer;
        
        // 退出登录
        document.getElementById('logout').onclick = function(){
            layer.confirm('确定要退出登录吗？', function(index){
                localStorage.removeItem('admin_token');
                localStorage.removeItem('admin_user');
                location.href = 'login.html';
            });
        };
    });
    </script>
</body>
</html>
