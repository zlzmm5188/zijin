<script>
// 九宫格标签切换功能
document.addEventListener('DOMContentLoaded', function() {
    const gridTabs = document.querySelectorAll('.grid-tab');
    const marketGrid = document.querySelector('#market-grid').parentElement;
    const serviceGrid = document.querySelector('#service-grid').parentElement;

    gridTabs.forEach(tab => {
        tab.addEventListener('click', function() {
            const gridType = this.getAttribute('data-grid');

            // 切换激活状态
            gridTabs.forEach(t => t.classList.remove('active'));
            this.classList.add('active');

            // 切换显示内容
            if (gridType === 'market') {
                marketGrid.style.display = 'block';
                serviceGrid.style.display = 'none';
            } else if (gridType === 'service') {
                marketGrid.style.display = 'none';
                serviceGrid.style.display = 'block';
            }
        });
    });
});
</script>
