.bank-card-item{background:linear-gradient(135deg,#111,#2a2a2a);border-radius:16px;padding:24px 20px;margin-bottom:16px;box-shadow:0 6px 16px rgba(0,0,0,.3);position:relative;overflow:hidden;color:#fff}
