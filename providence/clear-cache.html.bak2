<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>清除缓存 - Providence</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      .container {
        background: white;
        border-radius: 16px;
        padding: 40px;
        max-
        
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      }
      h1 {
        color: #333;
        margin-bottom: 20px;
        font-size: 28px;
      }
      .info {
        background: #f0f9ff;
        border-left: 4px solid #0ea5e9;
        padding: 16px;
        margin-bottom: 24px;
        border-radius: 4px;
      }
      .success {
        background: #f0fdf4;
        border-left: 4px solid #10b981;
        padding: 16px;
        margin-bottom: 24px;
        border-radius: 4px;
        display: none;
      }
      .btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 14px 28px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        
        margin-bottom: 12px;
        transition: transform 0.2s;
      }
      .btn:hover {
        transform: translateY(-2px);
      }
      .btn:active {
        transform: translateY(0);
      }
      .btn-secondary {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
      }
      .step {
        background: #fafafa;
        padding: 12px;
        margin: 8px 0;
        border-radius: 8px;
        font-size: 14px;
      }
      .step strong {
        color: #667eea;
      }
      .log {
        background: #1e293b;
        color: #10b981;
        padding: 16px;
        border-radius: 8px;
        font-family: "Courier New", monospace;
        font-size: 13px;
        max-height: 300px;
        overflow-y: auto;
        margin-top: 20px;
        display: none;
      }
      .log div {
        margin: 4px 0;
      }
          .brand { display: flex; flex-direction: row; align-items: center; gap: 8px; white-space: nowrap; justify-content: flex-start; }
          .page-title, .brand h1 { margin: 0; display: inline-block; white-space: nowrap; flex: 0 1 auto; }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>🔄 清除缓存工具</h1>

      <div class="info">
        <strong>为什么需要清除缓存？</strong><br />
        浏览器会缓存旧的JavaScript和CSS文件，导致API地址更新后仍使用旧地址。
      </div>

      <div class="success" id="successMsg">
        <strong>✅ 缓存已清除！</strong><br />
        现在可以正常登录了。
      </div>

      <button class="btn" onclick="clearAllCache()">🗑️ 清除所有缓存</button>
      <button class="btn btn-secondary" onclick="clearAndReload()">
        🔄 清除缓存并重新登录
      </button>

      <div style="margin-top: 24px">
        <strong>手动清除步骤：</strong>
        <div class="step">
          <strong>Windows/Linux:</strong> 按 Ctrl + Shift + Delete
          打开清除数据窗口
        </div>
        <div class="step">
          <strong>Mac:</strong> 按 Cmd + Shift + Delete 打开清除数据窗口
        </div>
        <div class="step">
          <strong>强制刷新:</strong> 按 Ctrl + Shift + R (Mac: Cmd + Shift + R)
        </div>
      </div>

      <div class="log" id="log"></div>
    </div>

    <script>
      function log(msg) {
        const logEl = document.getElementById("log");
        logEl.style.display = "block";
        const div = document.createElement("div");
        div.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
        logEl.appendChild(div);
        logEl.scrollTop = logEl.scrollHeight;
      }

      async function clearAllCache() {
        log("🚀 开始清除缓存...");

        try {
          // 1. 清除 Service Worker
          if ("serviceWorker" in navigator) {
            const registrations =
              await navigator.serviceWorker.getRegistrations();
            for (let registration of registrations) {
              await registration.unregister();
              log("✅ Service Worker 已清除");
            }
          }

          // 2. 清除 Cache Storage
          if ("caches" in window) {
            const cacheNames = await caches.keys();
            for (let name of cacheNames) {
              await caches.delete(name);
              log(`✅ Cache "${name}" 已删除`);
            }
          }

          // 3. 清除 LocalStorage
          localStorage.clear();
          log("✅ LocalStorage 已清除");

          // 4. 清除 SessionStorage
          sessionStorage.clear();
          log("✅ SessionStorage 已清除");

          // 5. 清除 IndexedDB
          if ("indexedDB" in window) {
            const dbs = await indexedDB.databases();
            for (let db of dbs) {
              indexedDB.deleteDatabase(db.name);
              log(`✅ IndexedDB "${db.name}" 已删除`);
            }
          }

          log("🎉 所有缓存已清除完成！");
          document.getElementById("successMsg").style.display = "block";
        } catch (error) {
          log("❌ 清除缓存出错: " + error.message);
          console.error(error);
        }
      }

      async function clearAndReload() {
        await clearAllCache();
        log("🔄 3秒后跳转到登录页面...");
        setTimeout(() => {
          window.location.href = "login.html?t=" + Date.now();
        }, 3000);
      }

      // 页面加载时检查缓存
      window.addEventListener("load", () => {
        log("📊 检查当前配置...");

        if (window.API_CONFIG) {
          log("✅ API_CONFIG 已加载");
          log("📍 API地址: " + window.API_CONFIG.baseURL);
        } else {
          log("⚠️ API_CONFIG 未加载");
        }
      });
    </script>
  </body>
</html>
