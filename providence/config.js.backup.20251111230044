// HTTP请求封装
class HttpClient {
  constructor(config) {
    this.baseURL = config.baseURL;
    this.timeout = config.timeout;
    this.debug = config.debug;
  }

  // 获取Token
  getToken() {
    return localStorage.getItem(API_CONFIG.tokenKey) || '';
  }

  // 设置Token
  setToken(token) {
    localStorage.setItem(API_CONFIG.tokenKey, token);
  }

  // 清除Token
  clearToken() {
    localStorage.removeItem(API_CONFIG.tokenKey);
  }

  // 通用请求方法
  async request(url, options = {}) {
    const {
      method = 'GET',
      data = null,
      headers = {},
      useToken = true
    } = options;

    // 构建完整URL
    const fullURL = this.baseURL + url;

    // 构建请求头
    const reqHeaders = {
      'Content-Type': 'application/json',
      ...headers
    };

    // 添加Token
    if (useToken) {
      const token = this.getToken();
      if (token) {
        reqHeaders['token'] = token;
      }
    }

    // 构建请求配置
    const reqConfig = {
      method,
      headers: reqHeaders,
      mode: 'cors',
      credentials: 'include'
    };

    // 添加请求体
    if (data && (method === 'POST' || method === 'PUT')) {
      if (reqHeaders['Content-Type'] === 'application/json') {
        reqConfig.body = JSON.stringify(data);
      } else {
        reqConfig.body = data;
      }
    }

    // 调试输出
    if (this.debug) {
      console.log('[API Request]', method, url, data);
    }

    try {
      // 发送请求
      const response = await fetch(fullURL, reqConfig);

      // 先获取响应文本，检查是否是JSON
      const text = await response.text();
      let result;

      try {
        result = JSON.parse(text);
      } catch (parseError) {
        // 如果不是JSON，检查是否是HTML错误页面
        if (text.trim().startsWith('<!DOCTYPE') || text.trim().startsWith('<html')) {
          console.error('[API Error]', url, '服务器返回HTML错误页面:', text.substring(0, 300));
          return {
            success: false,
            data: null,
            msg: `服务器返回错误页面 (HTTP ${response.status})，请检查API路径是否正确`
          };
        }
        console.error('[API Error]', url, '响应不是JSON:', text.substring(0, 200));
        return {
          success: false,
          data: null,
          msg: '服务器响应格式错误，请稍后再试'
        };
      }

      // 调试输出
      if (this.debug) {
        console.log('[API Response]', url, result);
      }

      // 检查响应状态（兼容多种成功标识）
      if (result.code === 200 || result.code === 1 || result.msg === 'ok' || result.msg === '登陆成功') {
        return {
          success: true,
          data: result.data || result,
          msg: result.msg || 'success'
        };
      } else {
        return {
          success: false,
          data: null,
          msg: result.msg || '请求失败'
        };
      }
    } catch (error) {
      console.error('[API Error]', url, error);
      return {
        success: false,
        data: null,
        msg: error.message || '网络错误'
      };
    }
  }

  // GET请求
  get(url, options = {}) {
    return this.request(url, { ...options, method: 'GET' });
  }

  // POST请求
  post(url, data, options = {}) {
    return this.request(url, { ...options, method: 'POST', data });
  }

  // PUT请求
  put(url, data, options = {}) {
    return this.request(url, { ...options, method: 'PUT', data });
  }

  // DELETE请求
  delete(url, options = {}) {
    return this.request(url, { ...options, method: 'DELETE' });
  }
}

