// Token 失效全局拦截器 - 智能版本
// ==========================================
(function() {
  // 保存原始 fetch
  const originalFetch = window.fetch;
  
  // API白名单 - 这些API的Token错误不会触发强制退出
  const WHITELIST_APIS = [
    '/api/finance/ribao-',  // 日利宝相关API
    '/api/user/profile.php', // 个人信息
  ];
  
  window.fetch = async function(...args) {
    try {
      const response = await originalFetch.apply(this, args);
      
      // 获取请求URL
      const url = typeof args[0] === 'string' ? args[0] : args[0].url;
      
      // 检查是否在白名单中
      const isWhitelisted = WHITELIST_APIS.some(pattern => url.includes(pattern));
      
      // 克隆响应以便读取
      const clonedResponse = response.clone();
      
      try {
        const data = await clonedResponse.json();
        
        // 检查 Token 失效
        if (data.code === -1 && 
            (data.msg.includes('登录') || 
             data.msg.includes('token') || 
             data.msg.includes('认证'))) {
          
          if (isWhitelisted) {
            console.warn('[拦截器] API在白名单中，跳过强制退出:', url);
            console.warn('[拦截器] 错误信息:', data.msg);
          } else {
            console.log('[拦截器] 检测到Token失效，即将跳转登录页');
            console.log('[拦截器] URL:', url);
            console.log('[拦截器] 响应:', data);
            
            // 清除本地存储
            localStorage.removeItem('token');
            localStorage.removeItem('userInfo');
            
            // 显示提示
            if (typeof showToast === 'function') {
              showToast('登录已过期，请重新登录');
            } else {
              alert('登录已过期，请重新登录');
            }
            
            // 延迟跳转
            setTimeout(() => {
              window.location.href = '/login.html';
            }, 1500);
          }
        }
      } catch (e) {
        // JSON 解析失败，忽略
        console.debug('[拦截器] JSON解析失败（可能是非JSON响应）');
      }
      
      return response;
    } catch (error) {
      console.error('[拦截器] 请求失败:', error);
      throw error;
    }
  };
  
  console.log('[拦截器] Token失效拦截器已启动（智能模式）');
})();
// 页面加载时检查 Token
(function() {
  // 需要登录的页面列表
  const requireAuthPages = [
    'profile.html',
    'recharge.html',
    'withdraw.html',
    'my-investments.html',
    'ribao.html',
    'team-rewards.html',
    'bank-cards.html'
  ];
  
  const currentPage = window.location.pathname.split('/').pop();
  
  if (requireAuthPages.includes(currentPage)) {
    const token = localStorage.getItem('token');
    
    if (!token) {
      console.log('[拦截器] 未登录，跳转登录页');
      window.location.href = '/login.html';
    }
  }
})();
