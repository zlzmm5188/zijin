<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>积分兑换 | PROVIDENCE</title>
    <link rel=\"icon\" href=\"favicon.ico\">
    <link rel=\"stylesheet\" href=\"styles.css?v=1762970708\">
    <style>
        /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
           🎨 Navy/Gold 设计系统 - 积分兑换页面
           ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
        
        :root {
            --bg-navy: #0C1526;
            --gold: #D6B25A;
            --gold-dark: #C9A647;
            --gold-light: rgba(214, 178, 90, 0.1);
            --points-purple: rgba(139, 92, 246, 0.25);
            --points-purple-border: rgba(139, 92, 246, 0.3);
            --text-primary: #FFFFFF;
            --text-secondary: rgba(255, 255, 255, 0.7);
            --card-bg: rgba(255, 255, 255, 0.05);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", sans-serif;
            background: var(--bg-navy);
            color: var(--text-primary);
            min-height: 100vh;
            padding-bottom: 80px;
        }
        
        /* ━━━ 顶栏 ━━━ */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(12, 21, 38, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(214, 178, 90, 0.15);
            padding: 14px 20px;
        }
        
        .topbar-inner {
            max-width: 600px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .back-btn {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: rgba(214, 178, 90, 0.1);
            color: var(--gold);
            text-decoration: none;
            font-size: 18px;
            transition: all 0.3s;
        }
        
        .back-btn:hover {
            background: rgba(214, 178, 90, 0.2);
            transform: translateX(-2px);
        }
        
        .page-title {
            font-size: 17px;
            font-weight: 600;
            color: var(--text-primary);
        }
        
        .record-btn {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: rgba(214, 178, 90, 0.1);
            color: var(--gold);
            font-size: 18px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .record-btn:hover {
            background: rgba(214, 178, 90, 0.2);
            transform: scale(1.05);
        }
        
        /* ━━━ 容器 ━━━ */
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        
        
        .exchange-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 20px;
        }
        
        .exchange-header .form-label {
            margin-bottom: 0;
        }
        
        .points-balance-inline {
            display: flex;
            align-items: baseline;
            gap: 6px;
            font-size: 14px;
            color: var(--text-secondary);
        }
        
        .points-balance-inline .balance-value {
            font-size: 20px;
            font-weight: 700;
            color: var(--gold);
        }
        
        .points-balance-inline .balance-unit {
            font-size: 13px;
            letter-spacing: 0.3px;
        }
        /* ━━━ 兑换表单 ━━━ */
        .exchange-form {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 16px;
            padding: 24px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }
        
        .form-label {
            font-size: 15px;
            color: var(--text-primary);
            margin-bottom: 12px;
            display: block;
            font-weight: 500;
        }
        
        .input-group {
            position: relative;
            margin-bottom: 16px;
        }
        
        .input-group input {
            width: 100%;
            padding: 14px 80px 14px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            color: var(--text-primary);
            font-size: 16px;
            transition: all 0.3s;
        }
        
        .input-group input:focus {
            outline: none;
            border-color: var(--gold);
            background: rgba(255, 255, 255, 0.08);
        }
        
        .input-group input::placeholder {
            color: var(--text-secondary);
        }
        
        .input-suffix {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
            font-size: 14px;
        }
        
        /* ━━━ 快捷金额按钮 ━━━ */
        .quick-amounts {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }
        
        .quick-btn {
            padding: 10px;
            background: rgba(214, 178, 90, 0.1);
            border: 1px solid rgba(214, 178, 90, 0.2);
            border-radius: 10px;
            color: var(--gold);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .quick-btn:hover {
            background: rgba(214, 178, 90, 0.2);
            border-color: var(--gold);
            transform: translateY(-2px);
        }
        
        .quick-btn:active {
            transform: translateY(0);
        }
        
        /* ━━━ 兑换预览区 ━━━ */
        .exchange-summary {
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 16px;
            padding: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 20px;
        }
        
        .summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .summary-row:last-child {
            border-bottom: none;
        }
        
        .summary-row.highlight {
            background: rgba(214, 178, 90, 0.05);
            margin: 0 -10px;
            padding: 12px 10px;
            border-radius: 8px;
        }
        
        .summary-row span:first-child {
            font-size: 14px;
            color: var(--text-secondary);
        }
        
        .summary-row span:last-child {
            font-size: 16px;
            font-weight: 600;
            color: var(--text-primary);
        }
        
        .summary-row.highlight span:last-child {
            color: var(--gold);
            font-size: 18px;
        }
        
        /* ━━━ 确认按钮 ━━━ */
        .btn-exchange {
            width: 100%;
            padding: 16px;
            background: linear-gradient(180deg, var(--gold), var(--gold-dark));
            border: none;
            border-radius: 12px;
            color: var(--bg-navy);
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            box-shadow: 0 4px 16px rgba(214, 178, 90, 0.3);
        }
        
        .btn-exchange:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(214, 178, 90, 0.4);
        }
        
        .btn-exchange:active {
            transform: translateY(0);
        }
        
        .btn-exchange:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }
        
        /* ━━━ 提示文字 ━━━ */
        .hint-text {
            text-align: center;
            font-size: 13px;
            color: var(--text-secondary);
            margin-top: 16px;
            line-height: 1.6;
        }
        
        /* ━━━ 底部导航栏 ━━━ */
        .tabbar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(12, 21, 38, 0.96);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-top: 1px solid rgba(214, 178, 90, 0.2);
            display: flex;
            justify-content: space-around;
            padding: 8px 0 max(8px, env(safe-area-inset-bottom));
            z-index: 120;
        }
        
        .tab {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            padding: 4px 0;
            color: rgba(255, 255, 255, 0.6);
            transition: all 0.2s ease;
        }
        
        .tab .ico {
            width: 24px;
            height: 24px;
            background-size: 22px 22px;
            background-repeat: no-repeat;
            background-position: center;
            margin-bottom: 4px;
            opacity: 0.6;
            transition: opacity 0.2s ease;
        }
        
        .tab .txt {
            font-size: 11px;
            letter-spacing: 0.2px;
        }
        
        .tab.active {
            color: #D6B25A;
        }
        
        .tab.active .ico {
            opacity: 1;
        }
        
        /* ━━━ 响应式 ━━━ */
        @media (max-width: 768px) {
            .container {
                padding: 16px;
            }
            
            .preview-amount {
                font-size: 28px;
            }
        }
    </style>
</head>
<body>
    <!-- 顶栏 -->
    <div class="topbar">
        <div class="topbar-inner">
            <a href="profile.html" class="back-btn">←</a>
            <div class="page-title">积分兑换</div>
            <div class="record-btn" onclick="location.href='points-record.html'">📋</div>
        </div>
    </div>

    <!-- 主容器 -->
    <div class="container">
        <!-- 积分卡片 -->
        <!-- 兑换表单 -->
        <div class="exchange-form">
            <div class="exchange-header">
                <label class="form-label">兑换积分</label>
                <div class="points-balance-inline">
                    <span class="balance-label">积分余额</span>
                    <span class="balance-value" id="headerPointsBalance">0</span>
                    <span class="balance-unit">分</span>
                </div>
            </div>
            <div class="input-group">
                <input 
                    type="number" 
                    id="pointsInput" 
                    placeholder="请输入积分数量"
                    min="100"
                    step="100"
                >
                <span class="input-suffix">积分</span>
            </div>
            
            <!-- 快捷金额按钮 -->
            <div class="quick-amounts">
                <button class="quick-btn" onclick="setPoints(100)">100</button>
                <button class="quick-btn" onclick="setPoints(500)">500</button>
                <button class="quick-btn" onclick="setPoints(1000)">1000</button>
                <button class="quick-btn" onclick="setPoints('all')">全部</button>
            </div>
        </div>

        <!-- 兑换预览 -->
        <div class="exchange-summary">
            <div class="summary-row">
                <span>消耗积分</span>
                <span id="willUsePoints">0</span>
            </div>
            <div class="summary-row highlight">
                <span>获得金额</span>
                <span id="willGetAmount">¥0.00</span>
            </div>
            <div class="summary-row">
                <span>剩余积分</span>
                <span id="remainPoints">0</span>
            </div>
        </div>

        <!-- 确认按钮 -->
        <button class="btn-exchange" id="exchangeBtn" onclick="confirmExchange()">
            确认兑换
        </button>

        <!-- 提示文字 -->
        <div class="hint-text">
            💡 最低兑换100积分，兑换后立即到账<br>
            积分可通过签到、邀请好友、投资项目等方式获取
        </div>
    </div>

    <!-- 底部导航栏 -->
    <nav class="tabbar" id="tabbar">
        <a class="tab" data-tab="home" href="index.html">
            <div class="ico ico-home"></div>
            <div class="txt">首页</div>
        </a>
        <a class="tab" data-tab="market" href="market.html">
            <div class="ico ico-finance"></div>
            <div class="txt">数据</div>
        </a>
        <a class="tab" data-tab="project" href="projects.html">
            <div class="ico ico-market"></div>
            <div class="txt">项目</div>
        </a>
        <a class="tab" data-tab="news" href="messages.html">
            <div class="ico ico-message"></div>
            <div class="txt">消息</div>
        </a>
        <a class="tab" data-tab="me" href="profile.html">
            <div class="ico ico-me"></div>
            <div class="txt">我的</div>
        </a>
    </nav>

    <script src="config.js?v=1762970708"></script>
    <script src="ios-toast.js?v=1762970708"></script>
    <script>
        (function() {
            const currentPage = window.location.pathname.split('/').pop() || 'index.html';
            document.querySelectorAll('.tabbar .tab').forEach(item => {
                const href = item.getAttribute('href');
                if (href === currentPage || (currentPage.includes('points') && href === 'profile.html')) {
                    item.classList.add('active');
                }
            });
        })();
    </script>
    <script src="js/points-exchange.js?v=20251112"></script>
</body>
</html>

