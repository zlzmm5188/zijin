<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
    <title>积分兑换 - Frevix</title>
    <link rel="stylesheet" href="css/ios-toast.css">
    <style>
        :root {
            --bg-dark: #0A1020;
            --bg-card-blue: #1C2F4D;
            --bg-card-blue-end: #102135;
            --gold-light: #F8E7C1;
            --gold-normal: #E8C991;
            --gold-deep: #D6B97A;
            --text-main: #F2F5FF;
            --text-sub: #9DA9BE;
            --text-dark: #2F3847;
            --text-muted: #7B8495;
            --white-card: #FAF8F4;
            --white-border: #EBE6DF;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            position: fixed;
            font-family: "SF Pro Display", "SF Pro Text", "PingFang SC", "Inter", -apple-system, sans-serif;
        }

        body {
            background:
                radial-gradient(circle at 30% 0%, rgba(33,55,88,.45), transparent 65%),
                radial-gradient(circle at 100% 20%, rgba(28,42,70,.35), transparent 60%),
                var(--bg-dark);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
        }

        /* 导航栏 */
        .nav-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: clamp(48px, 12vw, 56px);
            background: rgba(10, 16, 32, 0.85);
            backdrop-filter: blur(20px);
            border-bottom: 0.5px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            padding: 0 clamp(12px, 3vw, 16px);
            z-index: 100;
        }

        .nav-back {
            width: clamp(32px, 8vw, 40px);
            height: clamp(32px, 8vw, 40px);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: clamp(20px, 5vw, 24px);
            color: var(--text-main);
            cursor: pointer;
        }

        .nav-title {
            flex: 1;
            text-align: center;
            font-size: clamp(16px, 4vw, 18px);
            font-weight: 600;
        }

        .nav-history {
            width: clamp(32px, 8vw, 40px);
            height: clamp(32px, 8vw, 40px);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: clamp(12px, 3vw, 13px);
            font-weight: 500;
            color: var(--gold-normal);
            cursor: pointer;
        }

        /* 内容区 */
        .content {
            position: fixed;
            top: clamp(48px, 12vw, 56px);
            left: 0;
            right: 0;
            bottom: 0;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
            padding: clamp(12px, 3vw, 16px);
        }

        /* 余额卡片 */
        .balance-card {
            position: relative;
            background: linear-gradient(145deg, var(--bg-card-blue), var(--bg-card-blue-end));
            border-radius: clamp(16px, 4vw, 20px);
            padding: clamp(16px, 4vw, 20px);
            margin-bottom: clamp(12px, 3vw, 16px);
            box-shadow:
                0 15px 30px rgba(0,0,0,.55),
                inset 0 1px 0 rgba(255,255,255,0.10);
            overflow: hidden;
        }

        .balance-card::before {
            content: "";
            position: absolute;
            top: -50%;
            left: -20%;
            width: 140%;
            height: 100%;
            background: linear-gradient(120deg, transparent, rgba(255,255,255,0.12), transparent);
            filter: blur(28px);
            pointer-events: none;
        }

        .balance-card::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--gold-normal), transparent);
        }

        .balance-stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: clamp(10px, 2.5vw, 12px);
            position: relative;
            z-index: 1;
        }

        .stat-item {
            text-align: center;
            padding: clamp(10px, 2.5vw, 12px) clamp(6px, 1.5vw, 8px);
            background: rgba(255,255,255,0.05);
            border-radius: clamp(10px, 2.5vw, 12px);
            border: 1px solid rgba(255,255,255,0.08);
        }

        .stat-label {
            color: var(--text-sub);
            font-size: clamp(11px, 2.8vw, 12px);
            margin-bottom: clamp(4px, 1vw, 6px);
        }

        .stat-value {
            color: var(--gold-normal);
            font-size: clamp(16px, 4vw, 18px);
            font-weight: 700;
        }

        .stat-value.primary {
            font-size: clamp(20px, 5vw, 22px);
            background: linear-gradient(90deg, var(--gold-normal), var(--gold-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* 白色操作卡片 */
        .white-card {
            background: var(--white-card);
            border-radius: clamp(16px, 4vw, 18px);
            border: 1px solid var(--white-border);
            box-shadow: 0 8px 18px rgba(0,0,0,.15);
            padding: clamp(16px, 4vw, 20px);
        }

        .card-title {
            font-size: clamp(15px, 3.7vw, 16px);
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: clamp(14px, 3.5vw, 16px);
            display: flex;
            align-items: center;
            gap: clamp(6px, 1.5vw, 8px);
        }

        /* 双栏输入框 */
        .exchange-input-container {
            background: #fff;
            border: 1.5px solid var(--gold-normal);
            border-radius: clamp(14px, 3.5vw, 16px);
            padding: clamp(14px, 3.5vw, 16px);
            box-shadow: inset 0 2px 4px rgba(0,0,0,.05);
            margin-bottom: clamp(14px, 3.5vw, 16px);
        }

        .exchange-input-container:focus-within {
            border-color: var(--gold-deep);
            box-shadow:
                inset 0 2px 4px rgba(0,0,0,.05),
                0 0 0 3px rgba(232,201,145,0.15);
        }

        .currency-labels {
            display: flex;
            justify-content: space-between;
            margin-bottom: clamp(6px, 1.5vw, 8px);
        }

        .currency-label {
            font-size: clamp(11px, 2.8vw, 12px);
            font-weight: 600;
            color: var(--text-muted);
        }

        .amount-row {
            display: flex;
            align-items: center;
            gap: clamp(10px, 2.5vw, 12px);
        }

        .amount-input-wrapper {
            flex: 1;
        }

        .amount-input {
            width: 100%;
            border: none;
            background: transparent;
            font-size: clamp(22px, 5.5vw, 24px);
            font-weight: 700;
            color: var(--text-dark);
            outline: none;
        }

        .amount-input::placeholder {
            color: var(--text-muted);
            font-weight: 400;
        }

        .divider {
            width: 1px;
            height: clamp(28px, 7vw, 30px);
            background: linear-gradient(to bottom, transparent, var(--gold-normal), transparent);
        }

        .converted-amount-wrapper {
            flex: 1;
        }

        .converted-amount {
            width: 100%;
            font-size: clamp(22px, 5.5vw, 24px);
            font-weight: 700;
            color: var(--gold-deep);
            text-align: right;
        }

        /* 信息区 */
        .exchange-info {
            background: rgba(232,201,145,0.08);
            border-radius: clamp(10px, 2.5vw, 12px);
            padding: clamp(12px, 3vw, 14px);
            border: 1px solid rgba(232,201,145,0.2);
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: clamp(8px, 2vw, 10px);
        }

        .info-row:last-child {
            margin-bottom: 0;
        }

        .info-label {
            color: var(--text-muted);
            font-size: clamp(12px, 3vw, 13px);
        }

        .info-value {
            color: var(--text-dark);
            font-size: clamp(14px, 3.5vw, 15px);
            font-weight: 600;
        }

        /* 主按钮 */
        .submit-btn {
            width: 100%;
            height: clamp(50px, 12.5vw, 56px);
            background: linear-gradient(135deg, #F3D49A, #E2B76A);
            border: none;
            border-radius: clamp(26px, 6.5vw, 28px);
            font-size: clamp(16px, 4vw, 17px);
            font-weight: 700;
            color: #2B1B05;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(0,0,0,.20);
            transition: all 0.2s ease;
            margin-top: clamp(14px, 3.5vw, 16px);
        }

        .submit-btn:active {
            transform: scale(0.98);
        }

        .submit-btn:disabled {
            background: #C9C4BC;
            color: #7B7771;
            cursor: not-allowed;
            transform: none;
        }

        /* 底部弹窗 */
        .popup-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.55);
            z-index: 200;
            display: none;
            align-items: flex-end;
        }

        .popup-overlay.show {
            display: flex;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .popup-content {
            width: 100%;
            max-height: 28vh;
            background: #fff;
            border-radius: clamp(18px, 4.5vw, 20px) clamp(18px, 4.5vw, 20px) 0 0;
            padding: clamp(20px, 5vw, 24px);
            animation: rise 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes rise {
            from { transform: translateY(100%); }
            to { transform: translateY(0); }
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-4px); }
            75% { transform: translateX(4px); }
        }

        .popup-content.shake {
            animation: shake 0.3s ease;
        }

        .popup-title {
            font-size: clamp(16px, 4vw, 18px);
            font-weight: 700;
            color: var(--text-dark);
            text-align: center;
            margin-bottom: clamp(16px, 4vw, 20px);
        }

        .password-input {
            width: 100%;
            height: clamp(50px, 12.5vw, 56px);
            padding: 0 clamp(16px, 4vw, 20px);
            background: #F8F6F2;
            border: 2px solid #D4C9B8;
            border-radius: clamp(14px, 3.5vw, 16px);
            font-size: clamp(18px, 4.5vw, 20px);
            font-weight: 600;
            color: var(--text-dark);
            text-align: center;
            letter-spacing: clamp(4px, 1vw, 6px);
            outline: none;
            margin-bottom: clamp(14px, 3.5vw, 16px);
        }

        .password-input:focus {
            border-color: var(--gold-normal);
            box-shadow: 0 0 0 3px rgba(232, 201, 145, 0.15);
        }

        /* 小屏优化 */
        @media (max-height: 700px) {
            .balance-card { padding: clamp(14px, 3.5vw, 16px); }
            .white-card { padding: clamp(14px, 3.5vw, 16px); }
            .popup-content { max-height: 26vh; padding: clamp(16px, 4vw, 18px); }
        }

        @media (max-width: 360px) {
            .stat-value { font-size: 14px; }
            .stat-value.primary { font-size: 18px; }
            .amount-input, .converted-amount { font-size: 20px; }
        }
    </style>
</head>
<body>
    <!-- 导航栏 -->
    <div class="nav-bar">
        <div class="nav-back" onclick="goBack()">‹</div>
        <div class="nav-title">积分兑换</div>
        <div class="nav-history" onclick="goHistory()">明细</div>
    </div>

    <!-- 内容区 -->
    <div class="content">
        <!-- 余额卡片 -->
        <div class="balance-card">
            <div class="balance-stats-row">
                <div class="stat-item">
                    <div class="stat-label">当前积分</div>
                    <div class="stat-value primary" id="pointsBalance">0</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">今日获得</div>
                    <div class="stat-value" id="todayPoints">+0</div>
                </div>
                <div class="stat-item">
                    <div class="stat-label">累计兑换</div>
                    <div class="stat-value" id="totalExchange">0</div>
                </div>
            </div>
        </div>

        <!-- 白色操作卡片 -->
        <div class="white-card">
            <div class="card-title">
                <span>💰</span>
                <span>积分兑换人民币</span>
            </div>

            <!-- 双栏输入框 -->
            <div class="exchange-input-container">
                <div class="currency-labels">
                    <span class="currency-label">积分</span>
                    <span class="currency-label">人民币</span>
                </div>
                <div class="amount-row">
                    <div class="amount-input-wrapper">
                        <input
                            type="number"
                            class="amount-input"
                            id="exchangeAmount"
                            placeholder="0"
                            min="10"
                            oninput="calculateAmount()"
                        >
                    </div>
                    <div class="divider"></div>
                    <div class="converted-amount-wrapper">
                        <div class="converted-amount" id="convertedAmount">¥0.00</div>
                    </div>
                </div>
            </div>

            <div class="exchange-info">
                <div class="info-row">
                    <span class="info-label">兑换比例</span>
                    <span class="info-value">1 积分 = ¥1</span>
                </div>
                <div class="info-row">
                    <span class="info-label">最低兑换</span>
                    <span class="info-value">10 积分</span>
                </div>
            </div>

            <button class="submit-btn" id="exchangeBtn" onclick="showPasswordModal()">
                确认兑换
            </button>
        </div>
    </div>

    <!-- 支付密码弹窗 -->
    <div class="popup-overlay" id="passwordPopup">
        <div class="popup-content" id="popupContent">
            <div class="popup-title">输入支付密码</div>
            <input
                type="tel"
                class="password-input"
                id="payPassword"
                placeholder="请输入6位支付密码"
                maxlength="6"
                inputmode="numeric"
            >
            <button class="submit-btn" onclick="submitExchange()">确认兑换</button>
        </div>
    </div>

    <script src="js/ios-toast.js"></script>
    <script src="config.js"></script>
    <script>
        const API = new APIClient();
        let currentBalance = 0;

        document.addEventListener('DOMContentLoaded', function() {
            checkLogin();
            loadPointsBalance();
        });

        function checkLogin() {
            const token = localStorage.getItem('token');
            if (!token) {
                showToast('请先登录');
                setTimeout(() => {
                    window.location.href = '/login.html';
                }, 1500);
            }
        }

        async function loadPointsBalance() {
            try {
                const data = await API.get('/api/user/points-balance.php');

                if (data.code === 1) {
                    currentBalance = parseFloat(data.data.points) || 0;
                    document.getElementById('pointsBalance').textContent = currentBalance.toFixed(2);
                    document.getElementById('todayPoints').textContent = '+' + (parseFloat(data.data.today_points) || 0).toFixed(2);
                    document.getElementById('totalExchange').textContent = (parseFloat(data.data.total_exchange) || 0).toFixed(2);
                } else {
                    showToast(data.msg || '加载失败');
                }
            } catch (error) {
                console.error('加载积分余额失败:', error);
                showToast('加载失败，请刷新重试');
            }
        }

        function calculateAmount() {
            const points = parseFloat(document.getElementById('exchangeAmount').value) || 0;
            const money = points;

            document.getElementById('convertedAmount').textContent = '¥' + money.toFixed(2);

            const btn = document.getElementById('exchangeBtn');
            if (points < 10) {
                btn.disabled = true;
                btn.textContent = '最低兑换 10 积分';
            } else if (points > currentBalance) {
                btn.disabled = true;
                btn.textContent = '积分不足';
            } else {
                btn.disabled = false;
                btn.textContent = '确认兑换';
            }
        }

        function showPasswordModal() {
            const points = parseFloat(document.getElementById('exchangeAmount').value) || 0;

            if (points < 10) {
                showToast('最低兑换 10 积分');
                return;
            }

            if (points > currentBalance) {
                showToast('积分不足');
                return;
            }

            document.getElementById('passwordPopup').classList.add('show');
            document.getElementById('payPassword').value = '';
            setTimeout(() => {
                document.getElementById('payPassword').focus();
            }, 300);
        }

        function closePasswordModal() {
            document.getElementById('passwordPopup').classList.remove('show');
            document.getElementById('payPassword').value = '';
        }

        async function submitExchange() {
            const points = parseFloat(document.getElementById('exchangeAmount').value) || 0;
            const tradePassword = document.getElementById('payPassword').value;

            if (!tradePassword || tradePassword.length !== 6) {
                const popup = document.getElementById('popupContent');
                popup.classList.add('shake');
                setTimeout(() => popup.classList.remove('shake'), 300);
                showToast('请输入6位支付密码');
                return;
            }

            const btn = document.querySelector('#passwordPopup .submit-btn');
            btn.disabled = true;
            btn.textContent = '处理中...';

            try {
                const data = await API.post('/api/user/points-exchange.php', {
                    amount: points,
                    trade_password: tradePassword
                });

                if (data.code === 1) {
                    closePasswordModal();
                    showToast('兑换成功！');

                    document.getElementById('exchangeAmount').value = '';
                    document.getElementById('convertedAmount').textContent = '¥0.00';
                    calculateAmount();

                    setTimeout(() => {
                        loadPointsBalance();
                    }, 1000);
                } else {
                    const popup = document.getElementById('popupContent');
                    popup.classList.add('shake');
                    setTimeout(() => popup.classList.remove('shake'), 300);
                    showToast(data.msg || '兑换失败');
                }
            } catch (error) {
                console.error('兑换失败:', error);
                showToast('兑换失败，请重试');
            } finally {
                btn.disabled = false;
                btn.textContent = '确认兑换';
            }
        }

        function goBack() {
            window.location.href = 'profile.html';
        }

        function goHistory() {
            window.location.href = 'points-exchange-history.html';
        }

        document.getElementById('passwordPopup').addEventListener('click', function(e) {
            if (e.target === this) closePasswordModal();
        });

        document.getElementById('payPassword').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') submitExchange();
        });
    </script>
</body>
</html>

