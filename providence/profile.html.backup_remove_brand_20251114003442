<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
        content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
    <title>我的 - Providence</title>
    <link rel="stylesheet" href="styles.css?v=1763080408b227ix">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(180deg, #0e2b44, #091c2e)
        }

        body {
            overflow-x: hidden;
            padding-bottom: 80px;
            min-height: 100vh
        }

        #app {
            min-height: 100vh;
            margin: 0;
            padding: 0
        }

        /* 强制九宫格文字可见 */
        .grid-item .text,
        #profile-grid .grid-item .text,
        .action-grid .grid-item .text {
            color: #1a2332 !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            text-shadow: 0 1px 2px rgba(255, 255, 255, 0.9) !important;
            z-index: 999 !important;
            height: auto !important;
            line-height: 1.3 !important;
            margin-top: 8px !important;
        }

        /* 移除可能的顶部空白 */
        body::before,
        body::after,
        #app::before,
        #app::after {
            display: none !important
        }

        /* VIP升级进度 - 移动端自适应 */
        .vip-progress-container {
            position: relative;
            z-index: 2;
            margin-top: 0;
            padding: 0 clamp(12px, 3vw, 16px) clamp(10px, 2.5vw, 12px);
            display: block;
        }

        .vip-progress-label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: clamp(11px, 2.8vw, 12px);
            color: rgba(255, 255, 255, 0.95);
            margin-bottom: clamp(6px, 1.5vw, 8px);
            font-weight: 500;
        }

        .vip-progress-label span:first-child {
            color: rgba(255, 255, 255, 0.95);
        }

        .vip-progress-label span:last-child {
            color: #fbbf24;
            font-weight: 700;
            font-size: clamp(12px, 3vw, 14px);
            text-shadow: 0 1px 3px rgba(251, 191, 36, 0.5);
        }

        .vip-progress-bar {
            height: clamp(10px, 2.5vw, 12px);
            background: rgba(0, 0, 0, 0.4);
            border-radius: clamp(5px, 1.25vw, 6px);
            overflow: hidden;
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5);
            margin: 0;
            padding: 0;
            z-index: 20;
        }

        .vip-progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #d2b48c, #e6d3a3, #d4a574, #c9a884, #d2b48c);
            background-size: 200% 100%;
            animation: progress-shine 2s linear infinite;
            border-radius: clamp(5px, 1.25vw, 6px);
            transition: width 0.5s ease;
            min-width: 5%;
            width: 0%;
            box-shadow: 0 0 15px rgba(210, 180, 140, 0.8), 0 2px 10px rgba(196, 154, 108, 0.6), inset 0 1px 2px rgba(255, 255, 255, 0.3);
            position: relative;
            z-index: 21;
        }

        @keyframes progress-shine {
            0% {
                background-position: 200% 0
            }

            100% {
                background-position: -200% 0
            }
        }



        /* 退出 */
        .logout {
            margin: clamp(12px, 3vw, 16px) clamp(16px, 4vw, 20px) clamp(100px, 25vw, 120px);
            padding: clamp(8px, 2vw, 10px) clamp(12px, 3vw, 14px);
            background: linear-gradient(180deg, #dbeafe, #bfdbfe, #93c5fd);
            border-radius: 12px;
            border: 1px solid rgba(59, 130, 246, 0.3);
            text-align: center;
            color: #2563eb;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            min-height: clamp(44px, 11vw, 52px);
            display: flex;
            align-items: center;
            justify-content: center;
            /* 文字层级 */
            z-index: 2;
            /* 立体阴影效果 */
            box-shadow:
                0 4px 12px rgba(37, 99, 235, 0.2),
                0 2px 4px rgba(37, 99, 235, 0.15),
                inset 0 1px 2px rgba(255, 255, 255, 0.6),
                inset 0 -2px 4px rgba(37, 99, 235, 0.2);
        }

        /* 顶部高光 */
        .logout::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 50%;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0.05) 100%);
            border-radius: 12px 12px 50% 50%;
            pointer-events: none;
            z-index: 1;
        }

        /* 底部阴影 */
        .logout::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 30%;
            background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.15) 100%);
            border-radius: 0 0 12px 12px;
            pointer-events: none;
            z-index: 1;
        }

        .logout:active {
            transform: translateY(2px) scale(0.98);
            box-shadow:
                0 2px 6px rgba(37, 99, 235, 0.12),
                0 1px 2px rgba(37, 99, 235, 0.08),
                inset 0 2px 4px rgba(0, 0, 0, 0.2);
        }

        .logout:hover {
            transform: translateY(-2px);
            box-shadow:
                0 6px 18px rgba(37, 99, 235, 0.2),
                0 3px 6px rgba(37, 99, 235, 0.15),
                inset 0 1px 2px rgba(255, 255, 255, 0.3),
                inset 0 -2px 4px rgba(37, 99, 235, 0.2);
        }

        /* Profile 页面九宫格图标颜色和背景 - 强制覆盖缓存 */
        #profile-grid .grid-item .icon {
            background: #3C3B37 !important;
            box-shadow: none !important;
            position: relative !important;
        }

        #profile-grid .grid-item .icon svg {
            position: relative !important;
            z-index: 2 !important;
            filter: none !important;
        }

        /* 移除 SVG 元素上的滤镜属性 */
        #profile-grid .grid-item .icon svg path[filter],
        #profile-grid .grid-item .icon svg circle[filter],
        #profile-grid .grid-item .icon svg rect[filter],
        #profile-grid .grid-item .icon svg ellipse[filter],
        #profile-grid .grid-item .icon svg g[filter] {
            filter: none !important;
        }

        /* 移除 SVG 内部的滤镜元素，但保留渐变定义 */
        #profile-grid .grid-item .icon svg defs filter { display: none !important;
            display: none !important;
        }

        #profile-grid .grid-item .icon svg defs feGaussianBlur,
        #profile-grid .grid-item .icon svg defs feDropShadow,
        #profile-grid .grid-item .icon svg defs feOffset,
        #profile-grid .grid-item .icon svg defs feComponentTransfer,
        #profile-grid .grid-item .icon svg defs feMerge {
            display: none !important;
        }

        /* 图标颜色 - 温暖棕褐色/金色渐变 - 保留图标清晰度和层次 */
        /* 只修改渐变定义，不强制覆盖所有元素 */
        #profile-grid .grid-item .icon svg linearGradient stop[offset="0%"] {
            stop-color: #d2b48c !important;
        }

        #profile-grid .grid-item .icon svg linearGradient stop[offset="30%"],
        #profile-grid .grid-item .icon svg linearGradient stop[offset="40%"] {
            stop-color: #e6d3a3 !important;
        }

        #profile-grid .grid-item .icon svg linearGradient stop[offset="50%"],
        #profile-grid .grid-item .icon svg linearGradient stop[offset="70%"] {
            stop-color: #d4a574 !important;
        }

        #profile-grid .grid-item .icon svg linearGradient stop[offset="100%"] {
            stop-color: #c9a884 !important;
        }

        #profile-grid .grid-item .icon svg radialGradient stop[offset="0%"] {
            stop-color: #d2b48c !important;
        }

        #profile-grid .grid-item .icon svg radialGradient stop[offset="30%"],
        #profile-grid .grid-item .icon svg radialGradient stop[offset="40%"] {
            stop-color: #d4a574 !important;
        }

        #profile-grid .grid-item .icon svg radialGradient stop[offset="100%"] {
            stop-color: #c9a884 !important;
        }

        /* 统一描边颜色，添加金色反光效果 */
        #profile-grid .grid-item .icon svg path[stroke],
        #profile-grid .grid-item .icon svg circle[stroke],
        #profile-grid .grid-item .icon svg rect[stroke],
        #profile-grid .grid-item .icon svg ellipse[stroke] {
            stroke: #d4af37 !important;
            stroke-width: 1.5px !important;
            
        }

        /* 在SVG外层添加金色描边圆环 */
        #profile-grid .grid-item .icon svg {
            position: relative !important;
            z-index: 2 !important;
            filter: none !important;
        }

        /* 底部其他功能列表样式 */
        .other-functions {
            padding: clamp(8px, 2vw, 10px) clamp(16px, 4vw, 16px) clamp(100px, 25vw, 120px);
            margin-top: clamp(-12px, -3vw, -8px);
            position: relative;
            background-color: #ffffff;
            border-radius: clamp(12px, 3vw, 16px);
            overflow: hidden;
        }

        /* 移除原有背景遮罩 */
        .other-functions::before {
            display: none;
        }

        /* 资产区域布局 - 参考图样式 */
        .assets {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: clamp(12px, 3vw, 16px);
            position: relative;
            border-radius: clamp(10px, 2.5vw, 12px);
            overflow: visible;
            margin-top: clamp(-70px, -17.5vw, -60px);
            margin-bottom: clamp(-20px, -5vw, -16px);
            margin-left: clamp(-12px, -3vw, -10px);
            margin-right: clamp(-12px, -3vw, -10px);
            z-index: 2;
            padding-top: clamp(65px, 16.25vw, 75px);
            padding-bottom: clamp(14px, 3.5vw, 18px);
            padding-left: clamp(14px, 3.5vw, 18px);
            padding-right: clamp(14px, 3.5vw, 18px);
            min-height: auto;
        }

        .assets .brand {
            position: relative;
            z-index: 1;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: clamp(6px, 1.5vw, 8px);
            margin-bottom: clamp(8px, 2vw, 12px);
            margin-top: clamp(-8px, -2vw, -6px);
        }

        .assets .brand-info {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: clamp(4px, 1vw, 6px);
            min-width: 0;
            flex: 0 0 auto;
            justify-content: center;
        }

        .assets .brand-name-wrapper {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
            min-width: 0;
        }

        .assets .brand-name-logo {
            width: clamp(32px, 8vw, 40px);
            height: clamp(32px, 8vw, 40px);
            object-fit: contain;
            flex-shrink: 0;
            background: none;
            border: none;
            padding: 0;
            box-shadow: none;
        }

        .assets .brand-name {
            font-size: clamp(22px, 5.5vw, 26px);
            font-weight: 700;
            color: #fff !important;
            line-height: 1.4;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
            min-width: 0;
        }

        .assets .brand-subtitle {
            font-size: clamp(16px, 4vw, 18px);
            font-weight: 600;
            color: rgba(255, 255, 255, 0.9);
            line-height: 1.4;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
            min-width: 0;
        }

        .assets .asset-wrapper {
            display: flex;
            align-items: stretch;
            gap: clamp(10px, 2.5vw, 12px);
            justify-content: space-between;
            flex-wrap: nowrap;
            width: 100%;
            margin-top: 0;
        }

        .assets::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url('assets/ab8b3aa4cec09.png');
            background-size: 100% 100%;
            background-position: center center;
            background-repeat: no-repeat;
            border-radius: clamp(12px, 3vw, 14px);
            z-index: -1;
            pointer-events: none;
        }

        .assets::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.15);
            z-index: -1;
            pointer-events: none;
            border-radius: clamp(12px, 3vw, 14px);
        }

        /* 资产卡片 - 淡淡毛玻璃效果 */
        .asset {
            flex: 1 1 0;
            position: relative;
            z-index: 1;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-radius: clamp(8px, 2vw, 10px);
            padding: clamp(8px, 2vw, 10px) clamp(10px, 2.5vw, 14px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            min-width: 0;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: clamp(2px, 0.5vw, 3px);
        }

        .other-functions .func-list {
            position: relative;
            z-index: 1;
            max-width: clamp(600px, 90vw, 720px);
            margin: 0 auto;
        }

        .func-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: clamp(8px, 2vw, 10px);
            row-gap: clamp(6px, 1.5vw, 8px);
            align-items: stretch;
        }

        /* 会员等级也放第二排，保持2列整齐排列 */
        /* 立体按钮样式 - 紧凑水平布局 */
        .func-list .payment-method-card {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 12px;
            padding: clamp(8px, 2vw, 10px) clamp(12px, 3vw, 14px);
            display: flex;
            align-items: center;
            gap: clamp(10px, 2.5vw, 12px);
            min-height: clamp(44px, 11vw, 52px);
