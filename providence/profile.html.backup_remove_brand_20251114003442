<script>
// 更新独立用户信息卡片
(function() {
    const updateUserInfoCard = () => {
        const username = localStorage.getItem('username') || '用户';
        const userId = localStorage.getItem('user_id') || localStorage.getItem('uid') || '--';
        
        const nameEl = document.getElementById('userNameDisplay');
        const idEl = document.getElementById('userIdDisplay');
        
        if (nameEl) nameEl.textContent = username;
        if (idEl) idEl.textContent = userId;
    };
    
    // 页面加载时更新
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', updateUserInfoCard);
    } else {
        updateUserInfoCard();
    }
    
    // 监听用户数据更新
    window.addEventListener('userDataLoaded', updateUserInfoCard);
})();
</script>
