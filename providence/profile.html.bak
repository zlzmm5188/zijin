                <div class="payment-name">实名认证</div>
                <div class="payment-desc">完成身份验证</div>
              </div>
            </a>
            <!-- 第二排：交易记录、支付密码 -->
            <a class="func-item payment-method-card" href="records.html">
              <div class="payment-icon">📋</div>
              <div class="payment-info">
                <div class="payment-name">交易记录</div>
                <div class="payment-desc">查看充值提现记录</div>
              </div>
            </a>
            <a
              class="func-item payment-method-card"
              href="set-pay-password.html"
            >
              <div class="payment-icon">🔐</div>
              <div class="payment-info">
                <div class="payment-name">支付密码</div>
                <div class="payment-desc">设置或修改支付密码</div>
              </div>
            </a>
            <!-- 第三排：会员等级 -->
            <a class="func-item payment-method-card" href="vip-level.html">
              <div class="payment-icon">👑</div>
              <div class="payment-info">
                <div class="payment-name">会员等级</div>
                <div class="payment-desc">查看VIP等级与权益</div>
              </div>
            </a>
          </div>
          <div class="logout" onclick="handleLogout()">退出登录</div>
        </div>
      </main>
    </div>

    <nav class="tabbar">
      <a class="tab" href="index.html">
        <div class="ico ico-home"></div>
        <div class="txt">首页</div>
      </a>
      <a class="tab" href="market.html">
        <div class="ico ico-finance"></div>
        <div class="txt">数据</div>
      </a>
      <a class="tab" href="projects.html">
