              position: absolute;
              top: clamp(8px, 2vw, 12px);
              right: clamp(8px, 2vw, 12px);
              width: clamp(90px, 22.5vw, 120px);
              height: clamp(58px, 14.5vw, 78px);
              background-image: url(&quot;img/V1_small.png?v=1762754400&quot;);
              background-size: contain;
              background-position: center center;
              background-repeat: no-repeat;
              z-index: 3;
              overflow: visible;
            "
          ></div>
        </section>

        <!-- VIP升级进度条 - 移到VIP卡片内部或隐藏，保持与首页一致 -->
        <div
          class="vip-progress-container"
          style="
            margin: -10px 16px 12px 16px;
            position: relative;
            z-index: 2;
          "
        >
          <div
            class="vip-progress-label"
            style="
              display: flex;
              justify-content: space-between;
              align-items: center;
              font-size: clamp(11px, 2.8vw, 12px);
              color: rgba(255, 255, 255, 0.95);
              margin-bottom: clamp(6px, 1.5vw, 8px);
              font-weight: 500;
            "
          >
            <span>VIP升级进度</span>
            <span
              style="color: #fbbf24; font-weight: 700"
              id="vipProgressPercent"
              >0%</span
            >
          </div>
          <div
            class="vip-progress-bar"
            style="
              height: clamp(10px, 2.5vw, 12px);
              background: rgba(0, 0, 0, 0.4);
              border-radius: clamp(5px, 1.25vw, 6px);
              overflow: hidden;
              position: relative;
            "
          >
            <div
              class="vip-progress-fill"
              id="vipProgressFill"
              style="
                height: 100%;
                width: 5%;
                background: linear-gradient(90deg, #fbbf24, #f59e0b);
                border-radius: clamp(5px, 1.25vw, 6px);
                transition: width 0.6s ease;
                position: relative;
                overflow: hidden;
              "
            >
              <div
                style="
                  position: absolute;
                  top: 0;
                  left: 0;
                  right: 0;
                  bottom: 0;
                  background: linear-gradient(
                    90deg,
                    transparent 0%,
                    rgba(255, 255, 255, 0.3) 50%,
                    transparent 100%
                  );
                  animation: shimmer 2s infinite;
                "
              ></div>
            </div>
          </div>
        </div>

        <style>
          @keyframes shimmer {
            0% {
              transform: translateX(-100%);
            }

            100% {
              transform: translateX(100%);
            }
          }

          /* 九宫格响应式布局 - 紧急修复 2025-11-13 */
          .grid-9,
          .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            padding: 20px 15px;
          }

          .grid-item,
          .feature-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px 10px;
            min-height: 100px;
            text-align: center;
            background: linear-gradient(
              135deg,
              rgba(26, 58, 92, 0.05) 0%,
              rgba(26, 58, 92, 0.1) 100%
            );
            border-radius: 12px;
            transition: all 0.3s ease;
            cursor: pointer;
          }

          .grid-icon,
          .feature-icon {
            width: 48px;
            height: 48px;
            margin-bottom: 10px;
          }

          .grid-title,
          .feature-title {
            font-size: 15px;
            font-weight: 500;
            color: #1a3a5c;
          }

          /* 小屏幕适配 */
          @media (max-width: 768px) {
            .grid-9,
            .feature-grid {
              gap: 12px;
              padding: 15px 10px;
            }

            .grid-item,
            .feature-item {
              padding: 15px 8px;
              min-height: 90px;
            }

            .grid-icon,
            .feature-icon {
              width: 42px;
              height: 42px;
            }

            .grid-title,
            .feature-title {
              font-size: 14px;
            }
          }

          /* 超小屏幕适配 */
          @media (max-width: 360px) {
            .grid-9,
            .feature-grid {
              gap: 10px;
              padding: 12px 8px;
            }

            .grid-item,
            .feature-item {
              padding: 12px 5px;
              min-height: 80px;
            }

            .grid-icon,
            .feature-icon {
              width: 36px;
              height: 36px;
              margin-bottom: 8px;
            }

            .grid-title,
            .feature-title {
              font-size: 13px;
            }
          }

          /* 导航栏使用全局样式，不在此页面覆盖 */

          /* 九宫格图标图片大小适配 - 参考首页样式 */
          #profile-grid .grid-item .icon img {
            width: 100% !important;
            height: 100% !important;
            object-fit: contain !important;
            display: block !important;
            image-rendering: auto !important;
            transform: scale(1.7) !important;
            transform-origin: center center !important;
            filter: none !important;
            padding: 4px !important;
            position: relative !important;
          }

          /* 九宫格间距适配 - 参考首页样式 */
          #profile-grid {
            column-gap: clamp(8px, 2vw, 24px) !important;
            row-gap: clamp(12px, 3vw, 22px) !important;
            padding: clamp(6px, 1.5vw, 12px) clamp(2px, 1vw, 8px) clamp(4px, 2vw, 8px) !important;
          }

          /* grid-item容器 - 参考首页样式 */
          #profile-grid .grid-item {
            padding: 0 !important;
            min-height: auto !important;
          }

          /* 小屏幕优化 */
          @media (max-width: 375px) {
            #profile-grid .grid-item .icon {
              width: clamp(44px, 11vw, 56px) !important;
              height: clamp(44px, 11vw, 56px) !important;
