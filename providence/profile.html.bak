                  />
                </div>
                <div class="text">项目</div>
              </a>
              <a class="grid-item" href="profit-calendar.html">
                <div class="icon">
                  <img
                    src="assets/a3b391327f247.png?v=1763081296"
                    alt="收益"
                    onerror="this.style.display='none'"
                  />
                </div>
                <div class="text">收益</div>
              </a>
              <a class="grid-item" href="daily-checkin.html">
                <div class="icon">
                  <img
                    src="assets/a8c7f9f435de7.png?v=1763081296"
