    <script src="gestures.js?v=1762816500c" onerror="console.error('gestures.js 加载失败')"></script>
    <script src="earth-3d.js?v=1762816500e" onerror="console.error('earth-3d.js 加载失败')"></script>
    <script src="config.js?v=1763365509"></script>
    <script src="custom-modal.js?v=1762754400"></script>
    <script src="ios-toast.js?v=1762754400"></script>
    <script src="profile.js?v=1762816500"></script>
    <script>
      let assetVisible = true;
      function toggleAsset() {
        assetVisible = !assetVisible;
        const el = document.getElementById("totalAsset");
        if (el) {
          if (assetVisible) {
            el.textContent = el.dataset.value || "0.00";
          } else {
            el.textContent = "******";
          }
        }

        // 同时隐藏账号和ID的中间部分
        const userNameEl = document.getElementById("userNameBrand");
        const userIdEl = document.getElementById("userIdBrand");

        if (userNameEl) {
          if (assetVisible) {
            userNameEl.textContent = userNameEl.dataset.value || "PROVIDENCE";
          } else {
            const name = userNameEl.dataset.value || "PROVIDENCE";
            if (name.length > 4) {
              const start = name.substring(0, 2);
              const end = name.substring(name.length - 2);
              userNameEl.textContent = start + "****" + end;
            } else {
              userNameEl.textContent = "****";
            }
          }
        }

        if (userIdEl) {
          if (assetVisible) {
            userIdEl.textContent = userIdEl.dataset.value || "ID: --";
          } else {
            const id = userIdEl.dataset.idValue || "10847392";
            if (id.length > 4) {
              const start = id.substring(0, 2);
              const end = id.substring(id.length - 2);
              userIdEl.textContent = "ID: " + start + "****" + end;
            } else {
              userIdEl.textContent = "ID: ****";
            }
          }
        }
      }

      async function handleLogout() {
        const ok = await customConfirm("确定退出登录吗？", "退出登录");
        if (ok) {
          localStorage.removeItem("providence_token");
          window.location.href = "login.html";
        }
      }
    </script>
  </body>
</html>
