                <div class="text">签到</div>
              </a>
            </section>
        </div>

        <!-- 底部其他功能列表 -->
        <div class="other-functions" style="margin-top: clamp(8px, 2vw, 12px)">
          <div class="func-list">
            <!-- 第一排：银行卡绑定、实名认证 -->
            <a class="func-item payment-method-card" href="bank-cards.html">
