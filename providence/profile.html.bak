              <span id="nextVipLevel" style="color: #fcd34d; font-weight: 700"
                >VIP2</span
              >
              还需
            </div>
            <div style="color: #fcd34d; font-weight: 700; margin-top: 2px">
              <span id="needInvestAmount">0</span>元
            </div>
