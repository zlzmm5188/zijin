                    <div style="font-size:12px;color:#6b7280;margin-bottom:4px;">在管基金最佳任期回报</div>
                    <div style="font-size:16px;font-weight:600;color:#0f172a;">${manager.bestReturn}</div>
                </div>
            </div>
            <div>
                <div style="font-size:14px;font-weight:600;color:#0f172a;margin-bottom:8px;">📋 项目经理简介</div>
                <div style="font-size:13px;color:#3e4754;line-height:1.6;">${manager.bio}</div>
            </div>
        </div>
        <div style="padding:20px;border-top:1px solid #e5e9f0;">
            <button onclick="closeManagerModal()" style="width:100%;padding:12px;background:linear-gradient(180deg,#efe7d2,#e2d6b5);color:#0b1220;border:none;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;">关闭</button>
        </div>
    `;

    document.body.appendChild(overlay);
    document.body.appendChild(modal);
}

function closeManagerModal() {
    const overlay = document.querySelector('div[style*="position:fixed"][style*="z-index:10000"]');
    const modal = document.querySelector('div[style*="z-index:10001"]');
    if (overlay) overlay.remove();
    if (modal) modal.remove();
}

