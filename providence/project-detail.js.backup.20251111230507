// 获取用户信息
async function getUserInfo() {
    if (!user.token) {
        user.level = 0;
        user.money = 0;
        return;
    }

    try {
        await waitForAPI();

        if (window.API && window.API.user && window.API.user.getInfo) {
            const result = await window.API.user.getInfo();
            if (result.success && result.data) {
                user.level = parseInt(result.data.level) || 1;
                user.money = parseFloat(result.data.money) || 0;
        console.log('✅ 用户信息加载成功:', user);
                return;
            }
        }

        // 降级方案
    const API_BASE = window.API_CONFIG?.baseURL || 'https://api.frevix.top';
    const response = await fetch(API_BASE + '/user/user/index', {
            headers: { 'token': user.token }
        });
