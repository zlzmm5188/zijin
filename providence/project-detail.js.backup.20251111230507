}

// 获取项目详情
async function getProjectDetail(projectId) {
  try {
    await waitForAPI();

    const API_BASE = window.API_CONFIG?.baseURL || 'https://api.frevix.top';

    // 方案1：直接调用详情API（等待后端实现）
    const detailUrl = `${API_BASE}/fund/project/detail?id=${projectId}`;
    console.log('📡 [API请求] 项目详情:', detailUrl);

    try {
      const response = await fetch(detailUrl, {
        headers: { 'token': user.token }
      });
      const result = await response.json();

      if (result.code === 200 && result.data) {
        console.log('✅ [API响应] 项目详情:', result.data);
        return result.data;
      }
    } catch (detailError) {
      console.warn('⚠️ 详情API未实现，降级到列表查询');
    }

    // 方案2：降级 - 从项目列表中查找
        if (window.API && window.API.fund && window.API.fund.getList) {
      const listResult = await window.API.fund.getList();
      if (listResult.success && listResult.data) {
        for (const category of listResult.data) {
          if (category.list) {
            const project = category.list.find(p => p.id == projectId);
            if (project) {
              project.category_name = category.name;
              console.log('✅ [降级方案] 从列表找到项目:', project);
              return project;
            }
          }
        }
      }
    }

    throw new Error('项目不存在');
  } catch (error) {
    console.error('❌ 获取项目详情失败:', error);
    throw error;
  }
}

// 计算收益（调用后端API）
async function calculateProfit(projectId, amount) {
  try {
    await waitForAPI();

    const API_BASE = window.API_CONFIG?.baseURL || 'https://api.frevix.top';
    const calcUrl = `${API_BASE}/fund/project/calculate`;

    console.log('📡 [API请求] 收益计算:', { projectId, amount });

    const response = await fetch(calcUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'token': user.token
      },
      body: JSON.stringify({
        project_id: projectId,
        amount: amount
      })
    });

    const result = await response.json();

    if (result.code === 200 && result.data) {
      console.log('✅ [API响应] 收益计算:', result.data);
      return {
        profit: parseFloat(result.data.profit) || 0,
        total: parseFloat(result.data.total) || 0,
        dailyProfit: parseFloat(result.data.daily_profit) || 0
      };
    }

    // 如果后端API未实现，返回null（前端不计算）
    console.warn('⚠️ 收益计算API未实现');
    return null;

  } catch (error) {
    console.error('❌ 收益计算失败:', error);
    return null;
  }
}

