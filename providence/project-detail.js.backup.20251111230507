// ========== 事件绑定 ==========

function bindEvents() {
  // 金额输入事件（防抖处理）
  const inputEl = document.getElementById('amount');
  if (inputEl) {
    let debounceTimer = null;
    inputEl.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        handleAmountChange();
      }, 500); // 500ms 防抖
    });
  }
}

