// 金额输入变化 - 调用后端计算
async function handleAmountChange() {
  const inputEl = document.getElementById('amount');
  if (!inputEl || !projectData) return;

  const amount = parseFloat(inputEl.value) || 0;

  // 重置显示
  const profitEl = document.getElementById('estIncome');
  const totalEl = document.getElementById('estTotal');
  const rateEffEl = document.getElementById('rateEff');

  if (amount === 0) {
    if (profitEl) profitEl.textContent = '—';
    if (totalEl) totalEl.textContent = '—';
    if (rateEffEl) rateEffEl.textContent = '—';
    return;
  }

  // ✅ 调用后端API计算（不在前端计算）
  const result = await calculateProfit(projectData.id, amount);

  if (result) {
    if (profitEl) profitEl.textContent = '¥' + formatMoney(result.profit);
    if (totalEl) totalEl.textContent = '¥' + formatMoney(result.total);

    // 如果后端返回了实际年化，显示
    const totalRate = parseFloat(projectData[API_FIELD_MAP.totalRate]) || 0;
    if (rateEffEl) rateEffEl.textContent = formatPercent(totalRate);
  } else {
    // 后端API未实现，提示用户
    if (profitEl) profitEl.textContent = '计算中...';
    if (totalEl) totalEl.textContent = '计算中...';
  }
}

// 申请认购
async function handleInvest() {
    if (!user.token) {
        await showToast('', '请先登录');
    setTimeout(() => location.href = 'login.html', 1000);
        return;
    }

  const inputEl = document.getElementById('amount');
  const amount = parseFloat(inputEl.value) || 0;
  const minAmount = parseFloat(projectData[API_FIELD_MAP.minAmount]) || 0;
  const maxAmount = parseFloat(projectData[API_FIELD_MAP.maxAmount]) || 0;

  // 验证金额
  if (amount < minAmount) {
    await showToast('', `最低投资 ¥${formatMoney(minAmount)}`);
        return;
    }

  if (amount > maxAmount) {
    await showToast('', `最高投资 ¥${formatMoney(maxAmount)}`);
        return;
    }

  if (amount > user.money) {
        await showToast('', '余额不足，请先充值');
        return;
    }

  // 跳转到确认页面
  const projectId = projectData.id;
  location.href = `invest-confirm.html?id=${projectId}&amount=${amount}`;
}

