function calc() {
    const inp = document.getElementById('inp');
    if (!inp || !prod) return;

    const amt = parseFloat(inp.value) || 0;
    const rate = parseFloat(prod.rate) || 0;
    const vip = parseFloat(prod.vip_rate) || 0;
    const add = parseFloat(prod.added) || 0;
    const gift = parseFloat(prod.gift) || 0;
    const sum = rate + vip + add + gift;
    const day = parseInt(prod.day) || 0;

    const profit = amt * (sum / 100) * (day / 365);
    const total = amt + profit;

    document.getElementById('profit').textContent = '¥' + profit.toFixed(2);
    document.getElementById('total').textContent = '¥' + total.toFixed(2);
}

async function invest() {
    const btn = document.getElementById('btn');
    if (btn.classList.contains('disabled')) return;

    if (!user.token) {
        await showToast('', '请先登录');
        setTimeout(() => location.href = 'login.html', 500);
        return;
    }

    const amt = parseFloat(document.getElementById('inp').value) || 0;
    const min = parseFloat(prod.min) || 0;
    const max = parseFloat(prod.max) || 0;

    if (amt < min) {
        await showToast('', '最低投资¥' + min.toLocaleString());
        return;
    }

    if (amt > max) {
        await showToast('', '最高投资¥' + max.toLocaleString());
        return;
    }

    if (amt > user.money) {
        await showToast('', '余额不足，请先充值');
        return;
    }

    location.href = `invest-confirm.html?id=${prod.id}&amount=${amt}`;
}

function fmt(v) {
    const n = parseFloat(v) || 0;
    if (n >= 10000) return (n / 10000).toFixed(1) + '万';
    return n.toFixed(0);
}

function showErr(msg) {
    // 尝试多个可能的容器元素
    const contEl = document.getElementById('cont') || document.querySelector('.wrap') || document.body;
    if (contEl) {
        contEl.innerHTML = `
            <div style="text-align:center;padding:100px 20px;">
                <div style="font-size:56px;margin-bottom:16px;opacity:0.6;">⚠️</div>
                <div style="font-size:14px;color:rgba(255,255,255,0.9);margin-bottom:24px;">${msg}</div>
                <button onclick="history.back()" style="padding:12px 32px;background:rgba(255,255,255,0.96);color:#0f172a;border:none;border-radius:10px;cursor:pointer;font-weight:700;box-shadow:0 6px 20px rgba(0,0,0,0.25);">返回</button>
            </div>
        `;
    } else {
        console.error('[showErr] 无法找到容器元素');
        alert(msg);
    }
}

