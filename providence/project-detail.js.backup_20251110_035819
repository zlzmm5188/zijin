async function getUser() {
    if (!user.token) {
        user.level = 0;
        user.money = 0;
        return;
    }

    try {
        await waitForAPI();

        // 优先使用统一API封装
        if (window.API && window.API.user && window.API.user.getInfo) {
            const result = await window.API.user.getInfo();
            if (result.success && result.data) {
                user.level = parseInt(result.data.level) || 1;
                user.money = parseFloat(result.data.money) || 0;
                return;
            }
        }

        // 降级方案
        const API = window.API_CONFIG?.baseURL || 'https://v2api.hemlx.com';
        const r = await fetch(API + '/user/user/index', {
            headers: { 'token': user.token }
        });
        const j = await r.json();
        if (j.code === 200 && j.data) {
            user.level = parseInt(j.data.level) || 1;
            user.money = parseFloat(j.data.money) || 0;
        }
    } catch (e) {
        console.error('[User]', e);
    }
}

async function load(id) {
    console.log('[Load] ID:', id);

    try {
        await getUser();
        await waitForAPI();

        // 优先使用统一API封装
        let j = null;
        if (window.API && window.API.fund && window.API.fund.getList) {
            const result = await window.API.fund.getList();
            if (result.success && result.data) {
                j = { data: result.data, msg: 'ok' };
            }
        }

        // 降级方案
        if (!j) {
            const API = window.API_CONFIG?.baseURL || 'https://v2api.hemlx.com';
            const r = await fetch(API + '/fund/project/all');
            j = await r.json();
        }

        for (const cat of j.data) {
            if (cat.list) {
                prod = cat.list.find(p => p.id == id);
                if (prod) {
                    prod.catName = cat.name;
                    break;
                }
            }
        }

        if (!prod) {
            showErr('产品不存在');
            return;
        }

        console.log('[Prod]', prod);
        render();

    } catch (e) {
        console.error('[Load]', e);
        showErr('加载失败');
    }
}

// 格式化金额（中文短单位）
function formatAmountCN(amount) {
    if (!amount || amount === 0) return '—';
    if (amount >= 100000000) {
        return (amount / 100000000).toFixed(1) + '亿';
    }
    if (amount >= 10000) {
        return (amount / 10000).toFixed(0) + '万';
    }
    return amount.toLocaleString();
}

// 格式化周期（支持天和月）
function formatCycle(day) {
    if (!day || day === 0) return '—';
    if (day < 30) {
        return day + '天';
    } else if (day < 365) {
        const months = Math.round(day / 30);
        return months + '个月';
    } else {
        const years = Math.round(day / 365 * 10) / 10;
        return years + '年';
    }
}

// 格式化VIP加息（永远显示+X.X%）
function formatVIPRate(vip, add, gift) {
    const total = (parseFloat(vip) || 0) + (parseFloat(add) || 0) + (parseFloat(gift) || 0);
    if (total === 0) return '—';
    return '+' + total.toFixed(1) + '%';
}

