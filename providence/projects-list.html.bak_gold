<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/>
<title>PROVIDENCE · 固收优选系列</title>
<style>
:root{
  --navy-1:#08141f; --navy-2:#0d1d2b; --navy-3:#0a1723;
  --ink:#0f172a; --muted:#6b7280;
  --gold:#9e8a57; --gold2:#c8ba94;
  --lineD:rgba(255,255,255,.08);
  --radius:14px;
}

*{box-sizing:border-box}
html,body{height:100%}

body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","PingFang SC",sans-serif;
  color:#e9eef6;
  background:linear-gradient(180deg,var(--navy-3) 0%, var(--navy-2) 42%, var(--navy-1) 100%);
  padding-bottom:40px;
}

/* 顶部栏 */
.topbar{
  position:sticky;top:0;z-index:40;padding:14px 16px;
  background:linear-gradient(180deg,rgba(10,23,35,.95),rgba(10,23,35,.75));
  backdrop-filter:blur(6px);border-bottom:1px solid var(--lineD);
}

.brand {
  display:flex;align-items:center;gap:10px;
}

.back-btn {
  width:32px;height:32px;display:flex;align-items:center;justify-content:center;
  border-radius:8px;background:rgba(255,255,255,.08);color:#fff;font-size:20px;
  cursor:pointer;border:none;text-decoration:none;transition:all 0.2s ease;
}

.back-btn:hover {background:rgba(255,255,255,.12)}
.back-btn:active {transform:scale(0.95)}

.logo{
  height:26px;width:26px;border-radius:8px;
  background:url('img/logo.png') center/contain no-repeat;
  flex-shrink:0;
}

.page-title {
  margin:0;font-size:18px;font-weight:600;color:var(--gold2);letter-spacing:0.3px;
}

.badge{
  margin-left:auto;font-size:11px;padding:6px 10px;border-radius:999px;
  border:1px solid rgba(159,139,84,.4);background:rgba(159,139,84,.15);
  color:var(--gold2);flex-shrink:0;
}

/* Hero 区域 */
.hero{padding:20px 16px 18px;border-bottom:1px solid var(--lineD)}

.hero-card {
  background:linear-gradient(135deg, rgba(200, 186, 148, 0.15), rgba(200, 186, 148, 0.05));
  border-radius:16px;padding:16px;margin-bottom:12px;
  border:1px solid rgba(200, 186, 148, 0.2);
  box-shadow:0 8px 32px rgba(6,12,18,0.25), 0 2px 8px rgba(0,0,0,0.1);
  transition:all 0.3s ease;
}

.hero-card:hover {
  transform:translateY(-2px);
  box-shadow:0 12px 40px rgba(6,12,18,0.3), 0 4px 12px rgba(200, 186, 148, 0.2);
}

.hero-header {
  display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;
}

.hero-title{margin:0;font-size:18px;color:var(--gold2);font-weight:600}

.hero-desc {
  line-height:1.6;color:rgba(255,255,255,0.85);font-size:13px;margin:0 0 12px;
}

.hero-stats {
  background:rgba(8,20,31,0.4);border-radius:10px;padding:12px;
  border:1px solid rgba(200, 186, 148, 0.2);
  display:grid;grid-template-columns:1fr 1fr;gap:12px;
}

.stat-label {font-size:11px;color:rgba(200, 186, 148, 0.8);margin-bottom:4px}
.stat-value {
  font-size:16px;color:#d4af37;font-weight:700;
  font-family:'Courier New',monospace;
  text-shadow:0 0 8px rgba(212, 175, 55, 0.6);
}
.stat-value.white {color:#fff;text-shadow:none}

/* 筛选条 */
.filters{
  position:sticky;top:60px;z-index:35;padding:10px 16px;
  background:linear-gradient(180deg,rgba(10,23,35,.92),rgba(10,23,35,.72));
  border-bottom:1px solid var(--lineD);backdrop-filter:blur(6px);
}

.row{display:flex;gap:8px;flex-wrap:wrap}

.chip{
  font-size:12px;padding:8px 12px;border-radius:999px;cursor:pointer;
  border:1px solid var(--lineD);color:#d7ddea;background:rgba(255,255,255,.06);
  transition:all 0.2s ease;
}

.chip:hover {border-color:rgba(200, 186, 148, 0.3);background:rgba(255,255,255,.08)}

.chip.active{
  color:#0b1220;border-color:rgba(200, 186, 148, 0.6);
  background:linear-gradient(180deg,#efe7d2,#e2d6b5);
  box-shadow:0 2px 8px rgba(200, 186, 148, 0.25);
}

/* 列表容器 - 2列网格布局 */
.list{
  padding:12px 16px;
  display:grid;
  grid-template-columns:repeat(2, 1fr);
  gap:12px;
}

@media (max-width: 480px) {
  .list {
    grid-template-columns:1fr;
  }
}

/* 项目卡片 - 小卡片样式（VIP卡片风格）*/
.card {
  background:linear-gradient(135deg, rgba(200, 186, 148, 0.15), rgba(200, 186, 148, 0.05));
  color:#e9eef6;
  border:1px solid rgba(200, 186, 148, 0.2);
  border-radius:16px;
  padding:16px;
  cursor:pointer;
  transition:all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  position:relative;
  overflow:hidden;
  box-shadow:0 8px 32px rgba(6,12,18,0.25), 0 2px 8px rgba(0,0,0,0.1);
  display:flex;
  flex-direction:column;
}

.card:hover {
  transform:translateY(-4px);
  box-shadow:0 12px 40px rgba(6,12,18,0.3), 0 4px 12px rgba(200, 186, 148, 0.2);
  border-color:rgba(200, 186, 148, 0.35);
  background:linear-gradient(135deg, rgba(200, 186, 148, 0.18), rgba(200, 186, 148, 0.08));
}

.card:active {
  transform:translateY(-2px) scale(0.98);
}

/* 卡片标题 */
.card-header {
  display:flex;align-items:flex-start;justify-content:space-between;
  margin-bottom:8px;gap:8px;
}

.card-title {
  margin:0;font-size:16px;color:var(--gold2);font-weight:600;
  line-height:1.4;flex:1;min-width:0;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
  overflow:hidden;text-overflow:ellipsis;
}

.card-tag {
  background:rgba(200, 186, 148, 0.15);
  border:1px solid rgba(200, 186, 148, 0.3);
  color:var(--gold2);
  padding:3px 8px;border-radius:8px;font-size:10px;font-weight:600;
  white-space:nowrap;flex-shrink:0;
}

.card-tag.vip {
  background:linear-gradient(180deg,#efe9d6,#e2d7b7);
  color:#0b1220;border-color:rgba(200, 186, 148, 0.5);
}

/* 卡片分类 */
.card-cat {
  font-size:12px;color:rgba(255,255,255,0.7);margin-bottom:12px;
}

/* 卡片指标 */
.card-stats {
  display:flex;flex-direction:column;gap:8px;margin-bottom:12px;flex:1;
}

.card-stat {
  display:flex;justify-content:space-between;align-items:center;
  font-size:13px;
}

.card-stat-label {color:rgba(255,255,255,0.7)}
.card-stat-value {
  color:var(--gold2);font-weight:600;font-family:'Courier New',monospace;
}

.card-stat-value.big {
  font-size:20px;font-weight:700;
  text-shadow:0 0 8px rgba(200, 186, 148, 0.4);
}

/* 卡片按钮 */
.card-btn {
  width:100%;padding:10px;border-radius:10px;border:none;
  background:linear-gradient(180deg,#efe7d2,#e2d6b5);
  color:#0b1220;font-size:13px;font-weight:600;cursor:pointer;
  transition:all 0.3s ease;margin-top:auto;
  box-shadow:0 2px 8px rgba(200, 186, 148, 0.2);
}

.card-btn:hover {
  transform:translateY(-2px);
  box-shadow:0 6px 16px rgba(200, 186, 148, 0.35);
}

.card-btn:active {transform:scale(0.98)}

/* 加载状态 */
.loading-state {
  grid-column:1 / -1;text-align:center;padding:40px 20px;color:#c8d2dd;
}

.spinner {
  width:32px;height:32px;
  border:3px solid rgba(200, 186, 148, 0.2);
  border-top-color:var(--gold2);border-radius:50%;
  animation:spin 0.8s linear infinite;margin:0 auto 12px;
}

@keyframes spin {to {transform:rotate(360deg)}}

.loadmore{
  grid-column:1 / -1;
  margin:16px auto;padding:10px 14px;border-radius:12px;
  border:1px solid var(--lineD);background:rgba(255,255,255,.06);
  color:#e6edf6;font-size:13px;cursor:pointer;transition:all 0.2s ease;
}

.loadmore:hover {background:rgba(255,255,255,.08);border-color:rgba(200, 186, 148, 0.3)}
</style>
</head>
<body>

<!-- 顶部 -->
<div class="topbar">
  <div class="brand">
    <a href="javascript:history.back()" class="back-btn">←</a>
    <div class="logo"></div>
    <h1 class="page-title">固收优选系列</h1>
    <div class="badge">PROVIDENCE</div>
  </div>
</div>

<!-- Hero -->
<section class="hero">
  <div class="hero-card">
    <div class="hero-header">
      <h2 class="hero-title">固收优选系列</h2>
    </div>
    <p class="hero-desc">以固收为核心，辅以可转债、基金与精选 IPO 配售，追求长期稳健复利。</p>
    <div class="hero-stats">
      <div>
        <div class="stat-label">目前募集资金</div>
        <div class="stat-value" id="totalAmount">¥97,538,437</div>
      </div>
      <div style="text-align:right">
        <div class="stat-label">当前参与人数</div>
        <div class="stat-value white" id="participantCount">1,234</div>
      </div>
    </div>
  </div>
</section>

<!-- 筛选 -->
<div class="filters">
  <div class="row">
    <div class="chip active" data-chip="all">全部</div>
    <div class="chip" data-chip="ipo">IPO配售</div>
    <div class="chip" data-chip="bond">债券</div>
    <div class="chip" data-chip="newbie">新手</div>
    <div class="chip" data-chip="vip">VIP</div>
  </div>
</div>

<!-- 列表 -->
<section class="list" id="list">
  <div id="loading" class="loading-state">
    <div class="spinner"></div>
    <div>加载中...</div>
  </div>
  <button class="loadmore" id="more" style="display:none">加载更多</button>
</section>

<script src="config.js?v=1763365517"></script>
<script>
function waitForAPI() {
    return new Promise((resolve) => {
        if (window.API && window.API_CONFIG) {
            resolve();
            return;
        }
        let attempts = 0;
        const check = setInterval(() => {
            if (window.API && window.API_CONFIG || attempts++ > 6) {
                clearInterval(check);
                resolve();
            }
        }, 50);
    });
}

let projectData = {projects: []};
const chips = document.querySelectorAll('.chip');
const list = document.getElementById('list');
const loading = document.getElementById('loading');

function applyFilter(){
  const active = document.querySelector('.chip.active')?.dataset.chip || 'all';
  [...list.querySelectorAll('.card')].forEach(card=>{
    const type = card.dataset.type;
    const isVip = card.dataset.vip === 'true';
    const title = card.innerText.toLowerCase();
    let show = true;
    if(active==='ipo') show = type==='ipo';
    if(active==='bond') show = type==='bond';
    if(active==='newbie') show = title.includes('新手');
    if(active==='vip') show = isVip;
    card.style.display = show ? '' : 'none';
  });
}

chips.forEach(c=>c.addEventListener('click',()=>{
  chips.forEach(x=>x.classList.remove('active'));
  c.classList.add('active'); applyFilter();
}));

async function loadProjects() {
    try {
        await waitForAPI();
        
        const API_BASE = window.API_CONFIG?.baseURL || "https://apis.copla.top";
        const token = localStorage.getItem('providence_token') || localStorage.getItem('token') || '';

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 5000);

        try {
            let data = null;
            if (window.API && window.API.fund && window.API.fund.getList) {
                try {
                    const result = await Promise.race([
                        window.API.fund.getList(),
                        new Promise((_, reject) => setTimeout(() => reject(new Error('超时')), 5000))
                    ]);
                    if (result && result.success && result.data) {
                        data = { code: 1, data: { list: result.data }};
                    }
                } catch (e) {}
            }

            if (!data) {
                const response = await fetch(API_BASE + "/index.php/fund/project/all", {
                    headers: {
                        "Accept": "application/json",
                        "Content-Type": "application/json",
                        "token": token
                    },
                    signal: controller.signal
                });
                clearTimeout(timeoutId);

                if (!response.ok) throw new Error(`HTTP ${response.status}`);

                const text = await response.text();
                data = JSON.parse(text);
            }

            let projectList = null;
            if (data && data.code === 1 && data.data) {
                projectList = data.data.list || (Array.isArray(data.data) ? data.data : null);
            } else if (data && Array.isArray(data)) {
                projectList = data;
            }

            if (projectList && projectList.length > 0) {
                projectData.projects = projectList.map(p => ({
                    id: p.id,
                    title: p.name || p.title || "投资项目",
                    rate: parseFloat(p.daily_rate || p.base_rate || p.rate || 0),
                    vip_rate: parseFloat(p.added_rate || p.vip_rate || 0),
                    day: parseInt(p.total_days || p.cycle_days || p.day || 0),
                    min: parseFloat(p.min_invest || p.min || 0),
                    max: parseFloat(p.max_invest || p.max || 0),
                    vip: parseInt(p.vip_min || p.vip || 0),
                    categoryName: p.category || p.categoryName || "固收优选"
                }));

                renderProjects();
                loading.style.display = "none";
            } else {
                loading.innerHTML = '<div>暂无项目</div>';
            }
        } catch (e) {
            clearTimeout(timeoutId);
            loading.innerHTML = '<div>加载失败</div>';
            console.error(e);
        }
    } catch (error) {
        loading.innerHTML = '<div>加载失败</div>';
        console.error(error);
    }
}

function renderProjects() {
    const urlParams = new URLSearchParams(window.location.search);
    const isNewbieMode = urlParams.get('type') === 'newbie';
    
    if (isNewbieMode) {
        const titleEl = document.querySelector('.page-title');
        const heroTitleEl = document.querySelector('.hero-title');
        const heroDescEl = document.querySelector('.hero-desc');
        if (titleEl) titleEl.textContent = '新人体验金';
        if (heroTitleEl) heroTitleEl.textContent = '新人体验金专区';
        if (heroDescEl) heroDescEl.textContent = '专为新手打造，低门槛高收益。';
    }
    
    list.querySelectorAll('.card').forEach(c => c.remove());

    if (projectData.projects.length === 0) {
        loading.innerHTML = '<div>暂无项目</div>';
        loading.style.display = 'block';
        return;
    }

    let projectsToShow = projectData.projects;
    if (isNewbieMode) {
        projectsToShow = projectData.projects.filter(p => {
            const min = parseFloat(p.min || 0);
            const day = parseInt(p.day || 0);
            const rate = parseFloat(p.rate || 0);
            return min <= 20000 && day >= 15 && day <= 90 && rate >= 7 && rate <= 12;
        });
        
        if (projectsToShow.length === 0) {
            loading.innerHTML = '<div style="text-align:center;padding:40px">暂无新手项目</div>';
            loading.style.display = 'block';
            return;
        }
    }

    projectsToShow.forEach(project => {
        const card = createProjectCard(project);
        list.insertBefore(card, document.getElementById('more'));
    });
}

function createProjectCard(project) {
    const rate = parseFloat(project.rate || 0);
    const vipRate = parseFloat(project.vip_rate || 0);
    const totalRate = rate + vipRate;
    const day = parseInt(project.day || 0);
    const min = parseFloat(project.min || 0);
    const vipReq = parseInt(project.vip || 0);
    const isVipOnly = vipReq > 0;

    let type = 'bond';
    const catName = (project.categoryName || '').toLowerCase();
    const title = (project.title || '').toLowerCase();
    if (catName.includes('ipo') || title.includes('ipo') || title.includes('配售')) type = 'ipo';

    const card = document.createElement('article');
    card.className = 'card';
    card.dataset.type = type;
    card.dataset.vip = isVipOnly ? 'true' : 'false';

    let cycleText = '灵活';
    if (day > 0) {
        if (day < 30) cycleText = `${day}天`;
        else if (day < 365) cycleText = `${Math.floor(day/30)}个月`;
        else cycleText = `${Math.floor(day/365)}年`;
    }

    const rateText = totalRate > 0 ? `${totalRate.toFixed(2)}%` : '—';

    let tagHtml = '';
    if (isVipOnly) {
        tagHtml = `<span class="card-tag vip">VIP${vipReq}+</span>`;
    } else if (type === 'ipo') {
        tagHtml = '<span class="card-tag">IPO</span>';
    }

    card.innerHTML = `
    <div class="card-header">
      <h3 class="card-title">${project.title || '投资项目'}</h3>
      ${tagHtml}
    </div>
    <div class="card-cat">${project.categoryName || '固收优选'}</div>
    <div class="card-stats">
      <div class="card-stat">
        <span class="card-stat-label">年化收益</span>
        <span class="card-stat-value big">${rateText}</span>
      </div>
      <div class="card-stat">
        <span class="card-stat-label">投资周期</span>
        <span class="card-stat-value">${cycleText}</span>
      </div>
      <div class="card-stat">
        <span class="card-stat-label">起投金额</span>
        <span class="card-stat-value">¥${min.toLocaleString('zh-CN')}</span>
      </div>
    </div>
    <button class="card-btn" onclick="location.href='project-detail.html?id=${project.id}'">查看详情</button>
    `;

    return card;
}

document.addEventListener('DOMContentLoaded', () => {
    loadProjects();
});
</script>

</body>
</html>
