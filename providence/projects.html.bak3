<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <title>PROVIDENCE · 投资项目</title>
    <link rel="icon" href="favicon.ico" />
    <link rel="stylesheet" href="styles.css?v=1734518400" />
    <script src="anti-scan.js?v=1734518400"></script>
    <script src="gestures.js?v=1734518400"></script>
    <script src="ios-toast.js?v=1734518400"></script>
    <style>
      :root {
        --navy: #08141f;
        --navy2: #0f1f2e;
        --navy3: #0a1723;
        --paper: #f3f5f7;
        --ink: #0f172a;
        --muted: #6b7280;
        --gold: #9f8b54;
        --gold2: #c7b58a;
        --lineL: #e2e6ed;
        --lineD: rgba(255, 255, 255, 0.08);
        --radius: 14px;
      }

      * {
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
      }

      body {
        margin: 0;
        font-family:
          -apple-system,
          BlinkMacSystemFont,
          "SF Pro Text",
          "PingFang SC",
          Segoe UI,
          Roboto,
          Helvetica,
          Arial,
          sans-serif;
        color: #e9eef6;
        background: linear-gradient(
          180deg,
          var(--navy3),
          var(--navy2) 40%,
          var(--navy)
        );
        padding-bottom: 20px;
        transform: translateZ(0);
        -webkit-transform: translateZ(0);
      }

      /* 底部导航栏 - 使用全局样式，移除内联覆盖 */

      .ico-home {
        background-image: url("img/zy.png?v=1734518400") !important;
        background-size: contain !important;
        background-position: center !important;
      }

      .ico-finance {
        background-image: url("img/w1.png?v=1734518400") !important;
        background-size: contain !important;
        background-position: center !important;
      }

      .ico-market {
        background-image: url("img/xm.png?v=1734518400") !important;
        background-size: contain !important;
        background-position: center !important;
      }

      .ico-message {
        background-image: url("img/34.png?v=1734518400") !important;
        background-size: contain !important;
        background-position: center !important;
      }

      .ico-me {
        background-image: url("img/wd.png?v=1734518400") !important;
        background-size: contain !important;
        background-position: center !important;
      }

      /* 顶部栏 */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 40;
        padding: 14px 16px;
        background: linear-gradient(180deg, rgba(10, 23, 35, 0.95), rgba(10, 23, 35, 0.75));
        backdrop-filter: blur(6px);
        border-bottom: 1px solid var(--lineD);
      }

      .brand {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
      }

      .back-btn {
        width: 32px;
        height: 32px;
        min-width: 32px;
        min-height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
        border: none;
        text-decoration: none;
        flex-shrink: 0;
        white-space: nowrap;
        -webkit-tap-highlight-color: transparent;
        user-select: none;
        position: relative;
        z-index: 10;
        transition: background 0.2s ease;
      }

      .back-btn:hover {
        background: rgba(255, 255, 255, 0.12);
      }

      .back-btn:active {
        transform: scale(0.95);
        background: rgba(255, 255, 255, 0.15);
      }

      .brand h1 {
        display: inline-block;
        margin: 0;
        white-space: nowrap;
        flex-shrink: 1;
        font-size: 18px;
        letter-spacing: 0.3px;
        color: var(--gold2);
        font-weight: 600;
      }

      .badge {
        margin-left: auto;
        font-size: 11px;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(159, 139, 84, 0.4);
        background: rgba(159, 139, 84, 0.15);
        color: var(--gold2);
      }

      /* Hero */
      .hero {
        padding: 30px 16px 18px;
        border-bottom: 1px solid var(--lineD);
      }

      .hero h2 {
        margin: 0 0 6px;
        font-size: 22px;
        color: var(--gold2);
        font-weight: 600;
      }

      .hero p {
        margin: 0;
        color: #c9d2dd;
        font-size: 13px;
        line-height: 1.55;
      }

      .kpis {
        display: flex;
        gap: 10px;
        margin-top: 12px;
      }

      .kpi {
        flex: 1;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--lineD);
        border-radius: 12px;
        padding: 10px;
        text-align: center;
      }

      .kpi b {
        display: block;
        font-size: 16px;
        color: #ffffff;
        font-weight: 600;
      }

      .kpi small {
        font-size: 11px;
        color: #aeb8c6;
      }

      /* 区块容器（白卡） */
      .section {
        margin: 16px;
        background: rgba(243, 245, 247, 0.96);
        color: var(--ink);
        border: 1px solid var(--lineL);
        border-radius: var(--radius);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
      }

      .section .head {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 14px 4px;
      }

      .section .head h3 {
        margin: 0;
        font-size: 17px;
        font-weight: 600;
        color: #0f172a;
      }

      .section .head small {
        margin-left: auto;
        font-size: 12px;
        color: #617087;
      }

      /* 新手专区 */
      .benefits {
        padding: 8px 14px 14px;
      }

      .blist {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .b {
        background: #fff;
        border: 1px solid var(--lineL);
        border-radius: 12px;
        padding: 10px;
        cursor: pointer;
        transition:
          transform 0.1s ease,
          opacity 0.1s ease;
        will-change: transform;
      }

      .b:hover {
        transform: translateY(-2px);
      }

      .b:active {
        transform: translateY(0) scale(0.98);
      }

      .b b {
        display: block;
        color: #0f172a;
        font-weight: 600;
        margin-bottom: 4px;
      }

      .b small {
        font-size: 12px;
        color: #6b7280;
        display: block;
      }

      .b .rate {
        font-size: 14px;
        color: var(--gold);
        font-weight: 600;
        margin-top: 6px;
      }

      .tips {
        margin-top: 10px;
        font-size: 12px;
        color: #6c798c;
        line-height: 1.6;
      }

      /* VIP专区 */
      .vip {
        padding: 8px 14px 14px;
      }

      .viptop {
        background: linear-gradient(180deg, var(--gold2), var(--gold));
        color: #0b1220;
        border-radius: 12px;
        padding: 12px;
        border: 1px solid rgba(159, 139, 84, 0.6);
        margin-bottom: 12px;
      }

      .viptop b {
        display: block;
        font-weight: 600;
        margin-bottom: 4px;
      }

      .viptop small {
        font-size: 12px;
        opacity: 0.9;
      }

      .vgrid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }

      .vcard {
        background: #fff;
        border: 1px solid var(--lineL);
        border-radius: 12px;
        padding: 12px;
        cursor: pointer;
        transition:
          transform 0.1s ease,
          opacity 0.1s ease;
        will-change: transform;
      }

      .vcard:hover {
        transform: translateY(-2px);
      }

      .vcard:active {
        transform: translateY(0) scale(0.98);
      }

      .vcard b {
        color: #0f172a;
        font-weight: 600;
        display: block;
        margin-bottom: 4px;
      }

      .vcard .meta {
        font-size: 12px;
        color: #556070;
        margin-top: 4px;
        margin-bottom: 8px;
      }

      .tag {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 11px;
        color: #0b1220;
        background: linear-gradient(180deg, var(--gold2), var(--gold));
        border: 1px solid rgba(159, 139, 84, 0.55);
      }

      /* 热门专区 */
      .hot {
        padding: 8px 14px 14px;
      }

      .pcard {
        background: #fff;
        border: 1px solid var(--lineL);
        border-radius: 12px;
        padding: 12px;
        margin-top: 10px;
        cursor: pointer;
        transition:
          transform 0.1s ease,
          opacity 0.1s ease;
        will-change: transform;
      }

      .pcard:hover {
        transform: translateY(-2px);
      }

      .pcard:active {
        transform: translateY(0) scale(0.98);
      }

      .phead {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .phead b {
        color: #0f172a;
        font-weight: 600;
      }

      .phead span {
        font-size: 12px;
        color: #6b7280;
      }

      .pm {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
      }

      .pm img {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid rgba(159, 139, 84, 0.35);
      }

      .pm span {
        font-size: 12px;
        color: #3e4754;
      }

      .pbrief {
        margin-top: 8px;
        font-size: 13px;
        color: #495468;
        line-height: 1.55;
      }

      /* 主题入口（固收） */
      .theme {
        margin: 16px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid var(--lineD);
        border-radius: 14px;
        padding: 14px;
      }

      .theme h4 {
        margin: 0 0 6px;
        color: #e8edf6;
        font-weight: 600;
      }

      .theme p {
        margin: 0;
        color: #b9c4d2;
        font-size: 13px;
        line-height: 1.6;
      }

      .btn-mini {
        display: inline-block;
        margin-top: 10px;
        padding: 8px 14px;
        border-radius: 10px;
        font-size: 13px;
        color: #0b1220;
        cursor: pointer;
        background: linear-gradient(180deg, var(--gold2), var(--gold));
        border: 1px solid rgba(159, 139, 84, 0.6);
        text-decoration: none;
        transition:
          transform 0.1s ease,
          opacity 0.1s ease;
        will-change: transform;
      }

      .btn-mini:active {
        transform: scale(0.98);
      }

      /* 加载状态 */
      .loading-state {
        text-align: center;
        padding: 60px 20px;
        color: #c8d2dd;
      }
      .spinner {
        width: 24px;
        height: 24px;
        border: 3px solid rgba(200, 186, 148, 0.2);
        border-top-color: var(--gold2);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin: 0 auto 12px;
        will-change: transform;
        transform: translateZ(0);
      }
      @keyframes spin {
        to {
          transform: translateZ(0) rotate(360deg);
        }
      }

      .footerpad {
        height: 16px;
      }
    </style>
  </head>
  <body>
    <div class="topbar">
      <div class="brand">
        <a href="javascript:void(0);" onclick="history.back(); return false;" class="back-btn" style="display: flex; align-items: center; justify-content: center;">‹</a>
        <h1>稳健增值资产池</h1>
      </div>
    </div>

    <!-- Hero - 稳健增值资产池卡片 -->
    <section class="hero">
      <div class="hero-card" style="background: linear-gradient(135deg, rgba(200, 186, 148, 0.15), rgba(200, 186, 148, 0.05)); border-radius: 16px; padding: 20px; margin-bottom: 20px; border: 1px solid rgba(200, 186, 148, 0.2);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
          <h2 style="margin: 0; color: var(--gold2); font-size: 20px; font-weight: 600;">稳健增值资产池</h2>
          <a class="btn-mini" href="projects-list.html" style="white-space: nowrap; padding: 8px 16px; font-size: 13px;">查看固收系列</a>
        </div>
        <div style="line-height: 1.8; color: rgba(255, 255, 255, 0.85); font-size: 14px;">
          <p style="margin: 0 0 10px;">以固收为核心，辅以可转债、基金与精选 IPO 配售，追求长期稳健复利。我们通过严格的风险控制和专业的资产配置，为投资者提供安全、稳定、可持续的财富增值方案。</p>
        </div>
      </div>
    </section>

    <!-- 新手专区 -->
    <section class="section">
      <div class="head">
        <h3>新手专区</h3>
        <small>第一次配置，从这里开始</small>
      </div>
      <div class="benefits" id="newbieSection">
        <div class="loading-state">
          <div class="spinner"></div>
        </div>
      </div>
    </section>

    <!-- VIP专区 -->
    <section class="section">
      <div class="head">
        <h3>VIP专区</h3>
        <small>VIP 权益 · 加息与专属项目</small>
      </div>
      <div class="vip" id="vipSection">
        <div
          class="viptop"
          style="cursor: pointer"
          onclick="location.href='vip-benefits.html'"
        >
          <b>VIP 加息权益</b>
          <small>VIP3+ 享额外 +0.3%~0.8% 年化（随等级浮动）</small>
        </div>
        <div class="vgrid" id="vipProjects">
          <div class="loading-state">
            <div class="spinner"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 热门专区（含项目经理头像与简析） -->
    <section class="section">
      <div class="head">
        <h3>热门专区</h3>
        <small>本周主推 · PM 观点与项目拆解</small>
      </div>
      <div class="hot" id="hotSection">
        <div class="loading-state">
          <div class="spinner"></div>
        </div>
      </div>
    </section>

    <script src="config.js?v=1734518400"></script>
    <script>
      // ========== 等待API对象加载 ==========
      function waitForAPI() {
        return new Promise((resolve) => {
          if (window.API && window.API_CONFIG) {
            resolve();
          } else {
            const check = setInterval(() => {
              if (window.API && window.API_CONFIG) {
                clearInterval(check);
                resolve();
              }
            }, 100);
            setTimeout(() => {
              clearInterval(check);
              resolve();
            }, 2000);
          }
        });
      }

      // ========== 状态管理 ==========
      let user = {
        token:
          localStorage.getItem("providence_token") ||
          localStorage.getItem("token") ||
          "",
        level: 1,
        money: 0,
      };

      let projectData = {
        projects: [],
        categories: [],
      };

      // ========== 初始化 ==========
      // 使用 requestIdleCallback 优化初始化时机
      if (window.requestIdleCallback) {
        requestIdleCallback(() => {
          document.addEventListener("DOMContentLoaded", init, { once: true });
        });
      } else {
        document.addEventListener("DOMContentLoaded", init, { once: true });
      }

      async function init() {
        // 并行加载，减少等待时间
        await Promise.all([
          loadUserInfo().catch(() => {}),
          loadProjects().catch(() => {}),
        ]);
        updateKPI();
        // renderSections会在loadProjects中调用，这里不需要重复调用
      }

      // ========== 加载用户信息 ==========
      async function loadUserInfo() {
        if (!user.token) {
          user.level = 0;
          user.money = 0;
          return;
        }

        try {
          await waitForAPI();
          // 修复：使用正确的 API 域名和路径
          const API_BASE =
            window.API_CONFIG?.baseURL || "https://apis.copla.top";
          try {
            const response = await fetch(
              API_BASE + "/index.php/user/user/index",
              {
                method: 'GET',
                headers: {
                  'Content-Type': 'application/json',
                  token: user.token
                },
                mode: 'cors',
                credentials: 'omit'
              }
            );
            if (response.ok) {
              const text = await response.text();
              try {
                const data = JSON.parse(text);
                if ((data.code === 1 || data.code === 200) && data.data) {
                  user.level = parseInt(data.data.level) || 1;
                  user.money = parseFloat(data.data.money) || 0;
                }
              } catch (parseError) {
                console.warn("[User] JSON解析失败:", parseError.message);
              }
            }
          } catch (fetchError) {
            console.warn("[User] API请求失败，可能是网络问题:", fetchError.message);
            // 静默失败，不影响页面显示
          }
        } catch (e) {
          console.warn("[User] 加载用户信息失败:", e.message);
        }
      }

      // ========== 加载项目数据 ==========
      async function loadProjects() {
        try {
          await waitForAPI();
          let data = null;

          // 优先使用统一API封装
          if (window.API && window.API.fund && window.API.fund.getList) {
            const result = await window.API.fund.getList();
            if (result.success && result.data) {
              data = { code: 200, data: result.data, msg: "ok" };
              console.log("[Projects] 使用统一API封装");
            }
          }

          // 降级方案：直接调用API
          if (!data) {
            // 修复：使用正确的 API 域名和路径
            const API_BASE =
              window.API_CONFIG?.baseURL || "https://apis.copla.top";
            const token = localStorage.getItem('providence_token') || localStorage.getItem('token') || '';
            try {
              const response = await fetch(
                API_BASE + "/index.php/fund/project/all",
                {
                  method: 'GET',
                  headers: {
                    Accept: "application/json",
                    'Content-Type': 'application/json',
                    token: token
                  },
                  mode: 'cors',
                  credentials: 'omit'
                }
              );
              if (response.ok) {
                const text = await response.text();
                try {
                  data = JSON.parse(text);
                  console.log("[Projects] 使用直接API调用，返回数据:", data);
                } catch (parseError) {
                  console.warn("[Projects] JSON解析失败:", text.substring(0, 100));
                  data = { code: -1, data: [], msg: "服务器返回格式错误" };
                }
              } else {
                const errorText = await response.text();
                console.warn("[Projects] API请求失败:", response.status, errorText.substring(0, 100));
                data = { code: -1, data: [], msg: "API请求失败: " + response.status };
              }
            } catch (e) {
              console.warn("[Projects] API调用失败，可能是网络问题:", e.message);
              // 不抛出错误，显示空状态
              data = { code: -1, data: [], msg: "无法连接到服务器" };
            }
          }

          // 处理数据
          let projectList = null;
          if (data && data.code === 1 && data.data) {
            // 标准格式：{code: 1, data: [...]}
            if (Array.isArray(data.data)) {
              projectList = data.data;
            } else if (data.data.list && Array.isArray(data.data.list)) {
              projectList = data.data.list;
            } else if (data.data.data && Array.isArray(data.data.data)) {
              projectList = data.data.data;
            }
          } else if (data && data.data && Array.isArray(data.data)) {
            projectList = data.data;
          } else if (data && Array.isArray(data)) {
            projectList = data;
          }

          if (projectList && projectList.length > 0) {
            projectData.projects = [];
            projectData.categories = projectList;

            projectList.forEach((item) => {
              // 如果是分类对象，包含list数组
              if (item.list && Array.isArray(item.list)) {
                item.list.forEach((p) => {
                  p.categoryName = item.name || item.title || '';
                  projectData.projects.push(p);
                });
              }
              // 如果是项目对象，直接添加
              else if (item.id || item.title) {
                projectData.projects.push(item);
              }
            });

            console.log(
              "[Projects] 加载成功，共",
              projectData.projects.length,
              "个项目"
            );
            // 加载完成后渲染
            renderSections();
          } else {
            console.error("[Projects] API返回数据格式错误或为空:", data);
            // 即使没有数据，也渲染空状态
            renderSections();
          }
        } catch (error) {
          console.error("[Load Projects]", error);
        }
      }

      // ========== 带超时的fetch ==========
      // ========== 工具函数（已废弃，使用统一API） ==========
      function fetchWithTimeout(url, timeout = 8000) {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), timeout);
        return fetch(url, {
          signal: controller.signal,
          headers: { Accept: "application/json" },
        }).finally(() => {
          clearTimeout(timer);
        });
      }

      // ========== 更新KPI ==========
      // 使用固定值避免刷新时数据变动
      function updateKPI() {
        const activeProjects = projectData.projects.filter(
          (p) => p.status == 1
        );

        // 如果项目数据已加载，使用固定值或稳定的计算
        // 为了避免刷新时数据变动，使用固定范围显示
        const kpiEl = document.getElementById("kpis");
        if (kpiEl) {
          // 使用固定值，避免每次刷新都变动
          kpiEl.innerHTML = `
            <div class="kpi"><b>9%~13%</b><small>目标年化范围</small></div>
            <div class="kpi"><b>12~24月</b><small>常见投资周期</small></div>
            <div class="kpi"><b>¥10,000+</b><small>常见起投金额</small></div>
        `;
        }
      }

      // ========== 渲染各个专区 ==========
      function renderSections() {
        const activeProjects = projectData.projects.filter(
          (p) => p.status == 1
        );

        // 渲染新手专区
        renderNewbieSection(activeProjects);

        // 渲染VIP专区（对应后台is_vip=1的项目）
        renderVIPSection(activeProjects);

        // 渲染热门专区（对应后台is_hot=1的项目）
        renderHotSection(activeProjects);
      }

      // ========== 渲染新手专区 ==========
      function renderNewbieSection(projects) {
        // 新手项目：起投金额低、周期适中、风险较低
        const newbieProjects = projects
          .filter((p) => {
            const min = parseFloat(p.min_invest || p.min || 0) || 0;
            const day = parseInt(p.total_days || p.cycle_days || p.day || 0);
            const rate = parseFloat(p.base_rate || p.rate || p.daily_rate || 0) || 0;
            return (
              min <= 20000 && day >= 15 && day <= 90 && rate >= 7 && rate <= 12
            );
          })
          .sort((a, b) => {
            const aMin = parseFloat(a.min_invest || a.min || 0) || 0;
            const bMin = parseFloat(b.min_invest || b.min || 0) || 0;
            return aMin - bMin;
          })
          .slice(0, 2);

        const container = document.getElementById("newbieSection");
        if (!container) return;

        if (newbieProjects.length === 0) {
          container.innerHTML = `
            <div class="blist">
                <div class="b" onclick="location.href='trial-money.html'">
                    <b>新手礼遇</b><small>首笔申购享限时费用减免</small>
                    <div class="rate">领取体验金</div>
                </div>
                <div class="b" onclick="location.href='guide.html'">
                    <span style="font-size: 20px; margin-bottom: 4px;">📖</span>
                    <b>引导访问</b><small>新手引导，快速上手指南</small>
                </div>
            </div>
            <div class="tips">提示：新手项目以固收及低波动策略为主，强调回撤控制与资金效率。</div>
        `;
          return;
        }

        // 使用 DocumentFragment 优化DOM操作
        const fragment = document.createDocumentFragment();
        const containerDiv = document.createElement("div");
        containerDiv.className = "blist";

        // 创建引导卡片
        const guideDiv = document.createElement("div");
        guideDiv.className = "b";
        guideDiv.onclick = () => (location.href = "guide.html");
        guideDiv.innerHTML = `
        <img src="img/guide.png" alt="引导" style="width:24px;height:24px;margin-bottom:4px;" onerror="this.style.display='none'">
        <b>引导访问</b>
        <small>新手引导，快速上手指南</small>
        <div class="rate">✨ 查看指南</div>
    `;
        containerDiv.appendChild(guideDiv);

        // 创建项目卡片
        newbieProjects.forEach((p) => {
          const rate = parseFloat(p.base_rate || p.rate || p.daily_rate || 0) || 0;
          const vip = parseFloat(p.vip_rate || 0) || 0;
          const add = parseFloat(p.added_rate || p.added || 0) || 0;
          const gift = parseFloat(p.gift_rate || p.gift || 0) || 0;
          const totalRate = rate + vip + add + gift;
          const min = parseFloat(p.min_invest || p.min || 0) || 0;

          const projectDiv = document.createElement("div");
          projectDiv.className = "b";
          projectDiv.onclick = () => goToDetail(p.id);
          projectDiv.innerHTML = `
            <b>${p.name || p.title || "投资产品"}</b>
            <small>起投 ¥${formatMoney(min)}</small>
        `;
          containerDiv.appendChild(projectDiv);
        });

        fragment.appendChild(containerDiv);

        const tipsDiv = document.createElement("div");
        tipsDiv.className = "tips";
        tipsDiv.textContent =
          "提示：新手项目以固收及低波动策略为主，强调回撤控制与资金效率。";
        fragment.appendChild(tipsDiv);

        container.innerHTML = "";
        container.appendChild(fragment);
      }

      // ========== 渲染推荐专区 ==========
      function renderRecommendSection(projects) {
        // 推荐项目：对应后台is_recommend=1的项目
        const recommendProjects = projects
          .filter((p) => {
            // 检查is_recommend字段（可能是1、'1'、true等）
            return p.is_recommend == 1 || p.is_recommend === '1' || p.is_recommend === true || p.recommend == 1 || p.recommend === '1' || p.recommend === true;
          })
          .slice(0, 4); // 最多显示4个

        const container = document.getElementById("recommendSection");
        if (!container) return;

        if (recommendProjects.length === 0) {
          container.innerHTML = `
            <div class="blist">
                <div class="b" style="opacity: 0.6;">
                    <b>暂无推荐项目</b><small>敬请期待</small>
                </div>
            </div>
        `;
          return;
        }

        // 使用 DocumentFragment 优化DOM操作
        const fragment = document.createDocumentFragment();
        const containerDiv = document.createElement("div");
        containerDiv.className = "blist";

        // 创建项目卡片
        recommendProjects.forEach((p) => {
          const rate = parseFloat(p.base_rate || p.rate || p.daily_rate || 0) || 0;
          const vip = parseFloat(p.vip_rate || 0) || 0;
          const add = parseFloat(p.added_rate || p.added || 0) || 0;
          const gift = parseFloat(p.gift_rate || p.gift || 0) || 0;
          const totalRate = rate + vip + add + gift;
          const min = parseFloat(p.min_invest || p.min || 0) || 0;

          const projectDiv = document.createElement("div");
          projectDiv.className = "b";
          projectDiv.onclick = () => goToDetail(p.id);
          projectDiv.innerHTML = `
            <b>${p.name || p.title || "投资产品"}</b>
            <small>起投 ¥${formatMoney(min)}</small>
        `;
          containerDiv.appendChild(projectDiv);
        });

        fragment.appendChild(containerDiv);
        container.innerHTML = "";
        container.appendChild(fragment);
      }

      // ========== 渲染VIP专区 ==========
      function renderVIPSection(projects) {
        // VIP项目：对应后台is_vip=1的项目
        const vipProjects = projects
          .filter((p) => {
            // 检查is_vip字段（可能是1、'1'、true等）
            return p.is_vip == 1 || p.is_vip === '1' || p.is_vip === true || p.vip == 1 || p.vip === '1' || p.vip === true;
          })
          .sort((a, b) => {
            const aRate =
              (parseFloat(a.rate) || 0) + (parseFloat(a.vip_rate) || 0);
            const bRate =
              (parseFloat(b.rate) || 0) + (parseFloat(b.vip_rate) || 0);
            return bRate - aRate;
          })
          .slice(0, 2);

        const container = document.getElementById("vipProjects");
        if (!container) return;

        if (vipProjects.length === 0) {
          container.innerHTML = `
            <div class="vcard">
                <b>固收优选二期</b>
                <div class="meta">可转债增强</div>
                <span class="tag">VIP3+</span>
            </div>
            <div class="vcard">
                <b>中概进取 G2</b>
                <div class="meta">港美高增速</div>
                <span class="tag">VIP Only</span>
            </div>
        `;
          return;
        }

        const html = vipProjects
          .map((p) => {
            const rate = parseFloat(p.base_rate || p.rate || p.daily_rate || 0) || 0;
            const vip = parseFloat(p.vip_rate || 0) || 0;
            const add = parseFloat(p.added_rate || p.added || 0) || 0;
            const gift = parseFloat(p.gift_rate || p.gift || 0) || 0;
            const totalRate = rate + vip + add + gift;
            const vReq = parseInt(p.vip || 0) || 0;
            const tagText =
              vReq > 0
                ? `VIP${vReq}`
                : vip > 0 || add > 0 || gift > 0
                  ? "VIP3+"
                  : "VIP";

            return `
            <div class="vcard" onclick="goToDetail(${p.id}); return false;">
                <b>${p.name || p.title || "投资产品"}</b>
                <div class="meta">${p.category || p.categoryName || "固收优选"}</div>
                <span class="tag">${tagText}</span>
            </div>
        `;
          })
          .join("");

        container.innerHTML = html;
      }

      // ========== 渲染热门专区 ==========
      function renderHotSection(projects) {
        // 热门项目：对应后台is_hot=1的项目
        const hotProjects = projects
          .filter((p) => {
            // 检查is_hot字段（可能是1、'1'、true等）
            return p.is_hot == 1 || p.is_hot === '1' || p.is_hot === true || p.hot == 1 || p.hot === '1' || p.hot === true;
          })
          .slice(0, 2); // 最多显示2个

        const container = document.getElementById("hotSection");
        if (!container) return;

        if (hotProjects.length === 0) {
          container.innerHTML = `
            <div class="pcard">
                <div class="phead"><b>成长精选一期</b></div>
                <div class="pm">
                    <img src="https://picsum.photos/seed/pmA/60" alt="">
                    <span>刘哲 · 投研合伙人</span>
                </div>
                <div class="pbrief">核心逻辑：科技驱动 + 消费提质双轮，财务表现可验证，组合回撤缓冲与估值切换催化并行。</div>
            </div>
        `;
          return;
        }

        const managerNames = [
          "王帆",
          "沈明",
          "刘哲",
          "周屹",
          "陆峻",
          "陈皓",
          "张明",
        ];
        const managerTitles = [
          "转债模型负责人",
          "固收交易主管",
          "资产配置合伙人",
          "配售策略负责人",
          "固收量化",
          "投研合伙人",
          "固收总监",
        ];

        const html = hotProjects
          .map((p) => {
            const rate = parseFloat(p.base_rate || p.rate || p.daily_rate || 0) || 0;
            const vip = parseFloat(p.vip_rate || 0) || 0;
            const add = parseFloat(p.added_rate || p.added || 0) || 0;
            const gift = parseFloat(p.gift_rate || p.gift || 0) || 0;
            const totalRate = rate + vip + add + gift;
            const managerId = (p.manager_id || p.id || 0) % 146;
            const managerAvatar = p.manager_avatar || `img/good/img${String(managerId + 1).padStart(3, "0")}.jpg`;
            const managerName = p.manager_name || managerNames[managerId % managerNames.length];
            const managerTitle = p.manager_title || managerTitles[managerId % managerTitles.length];

            // 生成项目简介
            const day = parseInt(p.total_days || p.cycle_days || p.day || 0);
            const desc = p.description || p.subtitle || p.intro || p.desc || "";
            let brief = desc;
            if (!brief) {
              if (day <= 30) {
                brief = "短期理财产品，灵活便捷，适合资金周转需求。";
              } else if (day <= 90) {
                brief = "中期配置产品，追求稳健收益，平衡风险与回报。";
              } else {
                brief = "长期持有产品，专业团队管理，追求价值增长。";
              }
            }
            if (brief.length > 60) brief = brief.substring(0, 60) + "...";

            return `
            <div class="pcard" onclick="goToDetail(${p.id}); return false;">
                <div class="phead"><b>${p.name || p.title || "投资产品"}</b></div>
                <div class="pm">
                    <img src="${managerAvatar}" alt="${managerName}" onerror="this.src='img/user-avatar-default.svg'">
                    <span>${managerName} · ${managerTitle}</span>
                </div>
                <div class="pbrief">${brief}</div>
</div>
        `;
          })
          .join("");

        container.innerHTML = html;
      }

      // ========== 工具函数 ==========
      function formatMoney(value) {
        const num = parseFloat(value) || 0;
        if (num >= 100000000) return (num / 100000000).toFixed(1) + "亿";
        if (num >= 10000) return (num / 10000).toFixed(1) + "万";
        return num.toLocaleString("zh-CN", { maximumFractionDigits: 0 });
      }

      function goToDetail(id) {
        if (!id) return false;
        // 使用replace避免历史记录，添加时间戳防止缓存
        const url = "project-detail.html?id=" + id + "&t=" + Date.now();
        window.location.replace(url);
        return false;
      }
    </script>
  </body>
</html>
