<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <title>充值 | PROVIDENCE</title>
    <link rel="icon" href="favicon.ico">
    <link rel="stylesheet" href="design-tokens.css">
    <style>
        /* ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       🎨 高端金融机构风格 - Navy/Gold/White System
       ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", sans-serif;
            background: #0C1526;
            padding-bottom: 70px;
            min-height: 100vh;
            color: #333;
        }

        /* ━━━ 顶栏 ━━━ */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(12, 21, 38, 0.95);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(214, 178, 90, 0.15);
            padding: 14px 20px;
        }

        .topbar-inner {
            max-width: 600px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .back-btn {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: transparent;
            color: #D6B25A;
            font-size: 20px;
            text-decoration: none;
            border: 1px solid rgba(214, 178, 90, 0.2);
            transition: all 0.2s ease;
        }

        .back-btn:active {
            transform: scale(0.96);
            background: rgba(214, 178, 90, 0.08);
        }

        .page-title {
            flex: 1;
            text-align: center;
            font-size: 16px;
            font-weight: 600;
            color: #FFFFFF;
            letter-spacing: 0.5px;
        }

        .nav-spacer {
            width: 36px;
        }

        /* ━━━ 容器 ━━━ */
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }

        /* ━━━ 余额卡片 - 高端简约 ━━━ */
        .balance-section {
            background: #FFFFFF;
            border-radius: 12px;
            padding: 24px 20px;
            margin-bottom: 20px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(214, 178, 90, 0.12);
        }

        .balance-label {
            font-size: 13px;
            color: #666;
            margin-bottom: 8px;
            font-weight: 500;
            letter-spacing: 0.3px;
        }

        .balance-value {
            font-size: 40px;
            font-weight: 300;
            color: #0C1526;
            letter-spacing: -0.5px;
            font-family: -apple-system-ui-monospaced, "SF Pro Display", sans-serif;
        }

        .balance-value .symbol {
            font-size: 24px;
            color: #D6B25A;
            margin-right: 4px;
            font-weight: 400;
        }

        /* ━━━ 充值表单 - 专业简洁 ━━━ */
        .recharge-form {
            background: #FFFFFF;
            border-radius: 12px;
            padding: 24px 20px;
            margin-bottom: 20px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            border: 1px solid rgba(214, 178, 90, 0.12);
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-group:last-child {
            margin-bottom: 0;
        }

        .form-label {
            display: block;
            font-size: 14px;
            color: #333;
            font-weight: 600;
            margin-bottom: 12px;
            letter-spacing: 0.2px;
        }

        .amount-input-wrapper {
            position: relative;
        }

        .amount-input {
            width: 100%;
            height: 52px;
            border: 1.5px solid #E5E7EB;
            border-radius: 10px;
            padding: 0 16px;
            font-size: 20px;
            font-weight: 400;
            color: #0C1526;
            background: #FAFBFC;
            transition: all 0.2s ease;
            font-family: -apple-system-ui-monospaced, sans-serif;
            letter-spacing: 0.5px;
        }

        .amount-input:focus {
            outline: none;
            border-color: #D6B25A;
            background: #FFFFFF;
            box-shadow: 0 0 0 3px rgba(214, 178, 90, 0.08);
        }

        .amount-input::placeholder {
            color: #9CA3AF;
            font-weight: 400;
        }

        /* ━━━ 支付方式 - 银行级设计 ━━━ */
        .payment-methods {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .payment-option {
            display: flex;
            align-items: center;
            padding: 16px;
            border: 1.5px solid #E5E7EB;
            border-radius: 10px;
            background: #FAFBFC;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
        }

        .payment-option:active {
            transform: scale(0.99);
        }

        .payment-option.selected {
            background: #FFFFFF;
            border-color: #D6B25A;
            box-shadow: 0 2px 8px rgba(214, 178, 90, 0.12);
        }

        .payment-option.selected::after {
            content: '✓';
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #D6B25A;
            font-size: 18px;
            font-weight: 700;
        }

        .payment-icon {
            width: 48px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
        }

        .payment-icon svg {
            max-width: 100%;
            max-height: 100%;
        }

        .payment-info {
            flex: 1;
        }

        .payment-name {
            font-size: 15px;
            font-weight: 600;
            color: #1F2937;
            margin-bottom: 2px;
            letter-spacing: 0.2px;
        }

        .payment-desc {
            font-size: 12px;
            color: #6B7280;
            font-weight: 400;
        }

        /* ━━━ 提交按钮 - 简洁高端 ━━━ */
        .submit-section {
            margin-top: 28px;
        }

        .submit-btn {
            width: 100%;
            height: 52px;
            background: linear-gradient(135deg, #D6B25A 0%, #B79846 100%);
            border: none;
            border-radius: 10px;
            color: #0C1526;
            font-size: 16px;
            font-weight: 600;
            letter-spacing: 0.5px;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(214, 178, 90, 0.25);
        }

        .submit-btn:active {
            transform: translateY(1px);
            box-shadow: 0 2px 8px rgba(214, 178, 90, 0.2);
        }

        .submit-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        /* ━━━ 说明文字 - 低调专业 ━━━ */
        .notice-text {
            font-size: 12px;
            color: #9CA3AF;
            line-height: 1.6;
            margin-top: 16px;
            padding: 12px;
            background: rgba(214, 178, 90, 0.04);
            border-radius: 8px;
            border: 1px solid rgba(214, 178, 90, 0.08);
        }

        /* ━━━ 底部导航 ━━━ */
        .tabbar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-top: 1px solid rgba(0, 0, 0, 0.06);
            display: flex;
            justify-content: space-around;
            padding: 8px 0 max(8px, env(safe-area-inset-bottom));
            z-index: 100;
        }

        .tab {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            padding: 4px 0;
            transition: all 0.2s ease;
        }

        .ico {
            width: 24px;
            height: 24px;
            background-size: 24px 24px;
            background-repeat: no-repeat;
            background-position: center;
            margin-bottom: 4px;
            opacity: 0.5;
            transition: opacity 0.2s ease;
        }

        .tab.active .ico {
            opacity: 1;
        }

        .ico-home {
            background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23D6B25A"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>');
        }

        .ico-market {
            background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23D6B25A"><path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/></svg>');
        }

        .ico-education {
            background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23D6B25A"><path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"/></svg>');
        }

        .ico-me {
            background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="%23D6B25A"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>');
        }

        .txt {
            font-size: 10px;
            color: #9CA3AF;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .tab.active .txt {
            color: #D6B25A;
            font-weight: 600;
        }

        /* ━━━ 响应式 ━━━ */
        @media (max-width: 380px) {
            .balance-value {
                font-size: 36px;
            }

            .amount-input {
                font-size: 18px;
                height: 48px;
            }

            .submit-btn {
                height: 48px;
                font-size: 15px;
            }
        }
    </style>
</head>

<body>
    <!-- 顶栏 -->
    <div class="topbar">
        <div class="topbar-inner">
            <a href="profile.html" class="back-btn">←</a>
            <div class="page-title">账户充值</div>
            <div class="nav-spacer"></div>
        </div>
    </div>

    <!-- 主内容 -->
    <div class="container">
        <!-- 余额卡片 -->
        <div class="balance-section">
            <div class="balance-label">可用余额</div>
            <div class="balance-value">
                <span class="symbol">¥</span><span id="currentBalance">0.00</span>
            </div>
        </div>

        <!-- 充值表单 -->
        <div class="recharge-form">
            <!-- 充值金额 -->
            <div class="form-group">
                <label class="form-label">充值金额</label>
                <div class="amount-input-wrapper">
                    <input type="number" class="amount-input" id="amountInput" placeholder="请输入金额" min="100" step="100">
                </div>
            </div>

            <!-- 支付方式 -->
            <div class="form-group">
                <label class="form-label">支付方式</label>
                <div class="payment-methods">
                    <!-- 银联卡 -->
                    <div class="payment-option selected" data-method="bank" onclick="selectPayment(this)">
                        <div class="payment-icon">
                            <svg viewBox="0 0 120 40" xmlns="http://www.w3.org/2000/svg">
                                <rect width="120" height="40" rx="4" fill="#E01E27" />
                                <path d="M15 12h90v4H15z" fill="#fff" />
                                <path d="M15 20h90v4H15z" fill="#fff" opacity="0.7" />
                                <circle cx="25" cy="25" r="8" fill="#0052A5" />
                                <circle cx="35" cy="25" r="8" fill="#E01E27" opacity="0.8" />
                            </svg>
                        </div>
                        <div class="payment-info">
                            <div class="payment-name">中国银联</div>
                            <div class="payment-desc">支持所有银联卡</div>
                        </div>
                    </div>

                    <!-- USDT -->
                    <div class="payment-option" data-method="usdt" onclick="selectPayment(this)">
                        <div class="payment-icon">
                            <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="20" cy="20" r="20" fill="#26A17B" />
                                <path
                                    d="M22 15V12h-4v3H12v3h6v2c-2.8.3-5 1-5 1.8s2.2 1.5 5 1.8V28h4v-4.4c2.8-.3 5-1 5-1.8s-2.2-1.5-5-1.8v-2h6v-3h-6z"
                                    fill="#fff" />
                            </svg>
                        </div>
                        <div class="payment-info">
                            <div class="payment-name">USDT (TRC20)</div>
                            <div class="payment-desc">泰达币支付</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 提交按钮 -->
            <div class="submit-section">
                <button class="submit-btn" onclick="submitRecharge()">确认充值</button>
                <div class="notice-text">
                    • 最低充值金额：¥100<br>
                    • 到账时间：即时到账<br>
                    • 如遇问题请联系在线客服
                </div>
            </div>
        </div>
    </div>

    <!-- 底部导航 -->
    <div class="tabbar">
        <a class="tab" data-tab="home" href="index.html">
            <div class="ico ico-home"></div>
            <div class="txt">首页</div>
        </a>
        <a class="tab" data-tab="project" href="projects.html">
            <div class="ico ico-market"></div>
            <div class="txt">项目</div>
        </a>
        <a class="tab" data-tab="education" href="education.html">
            <div class="ico ico-education"></div>
            <div class="txt">课堂</div>
        </a>
        <a class="tab active" data-tab="me" href="profile.html">
            <div class="ico ico-me"></div>
            <div class="txt">我的</div>
        </a>
    </div>

    <!-- JavaScript -->
    <script src="ios-toast.js"></script>
    <script src="api-utils.js"></script>
    <script>
        let selectedMethod = 'bank';

        // 加载余额
        async function loadBalance() {
            try {
                const token = localStorage.getItem('providence_token');
                if (!token) return;

                const response = await fetch('https://api.frevix.top/user/user/index', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                const data = await response.json();

                if (data.code === 200) {
                    const balance = parseFloat(data.data.balance || 0);
                    document.getElementById('currentBalance').textContent =
                        balance.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
            } catch (error) {
                console.error('加载余额失败:', error);
            }
        }

        // 选择支付方式
        function selectPayment(element) {
            document.querySelectorAll('.payment-option').forEach(opt => opt.classList.remove('selected'));
            element.classList.add('selected');
            selectedMethod = element.dataset.method;
        }

        // 提交充值
        async function submitRecharge() {
            const amount = document.getElementById('amountInput').value;

            if (!amount || amount < 100) {
                showToast('请输入有效金额（最低¥100）');
                return;
            }

            try {
                const token = localStorage.getItem('providence_token');
                if (!token) {
                    showToast('请先登录');
                    setTimeout(() => window.location.href = 'login.html', 1500);
                    return;
                }

                // 这里调用充值API
                showToast('充值功能开发中');

            } catch (error) {
                console.error('充值失败:', error);
                showToast('充值失败，请稍后重试');
            }
        }

        // 页面加载
        document.addEventListener('DOMContentLoaded', () => {
            loadBalance();
        });
    </script>
</body>

</html>
