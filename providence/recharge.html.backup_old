<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover"
        />
        <title>充值 - Providence</title>
        <script src="js/send-title-to-parent.js"></script>
        <script src="js/remove-tabbar-from-pages.js"></script>
        <script src="js/swipe-back.js"></script>
        <style>
            :root { --bg-dark: #0A1020;
                        --bg-card-blue: #1C2F4D;
                        --bg-card-blue-end: #102135;

                        --gold-light: #F8E7C1;
                        --gold-normal: #E8C991;
                        --gold-deep: #D6B97A;

                        --text-main: #F2F5FF;
                        --text-sub: #9DA9BE;
                        --text-dark: #2F3847;
                        --text-muted: #7B8495;

                        --white-card: #FAF8F4; }
            * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
            html, body { width: 100%;
                        height: 100%;
                        overflow-y: auto;

                        font-family: "SF Pro Display", "SF Pro Text", "PingFang SC", "Inter", -apple-system, sans-serif; }
            body { background:
                            radial-gradient(circle at 30% 0%, rgba(33,55,88,.45), transparent 65%),
                            radial-gradient(circle at 100% 20%, rgba(28,42,70,.35), transparent 60%),
                            var(--bg-dark);
                        color: var(--text-main);
                        padding-top: 56px;  /* 为 app.html 的标题栏留出空间 */
                        flex-direction: column; }
            /* 内容区 */
                    .content { top: clamp(48px, 12vw, 56px);
                        left: 0;
                        right: 0;
                        bottom: 0;
                        overflow-y: auto;
                        -webkit-overflow-scrolling: touch;
                        padding: clamp(12px, 3vw, 16px); }
            /* 余额卡片 - 深蓝金融特效卡片 */
                    .balance-card { position: relative;
                        background: linear-gradient(145deg, var(--bg-card-blue), var(--bg-card-blue-end));
                        border-radius: clamp(14px, 3.5vw, 16px);
                        padding: clamp(16px, 4vw, 20px) clamp(14px, 3.5vw, 16px);
                        margin-bottom: clamp(12px, 3vw, 16px);
                        box-shadow:
                            0 15px 30px rgba(0,0,0,.55),
                            inset 0 1px 0 rgba(255,255,255,0.10);
                        overflow-y: auto; }
            /* 玻璃反光层 */
                    .balance-card::before { content: '';
                        position: absolute;
                        top: -50%;
                        left: -20%;
                        width: 140%;
                        height: 100%;
                        background: linear-gradient(120deg, transparent, rgba(255,255,255,0.12), transparent);
                        filter: blur(28px);
                        pointer-events: none; }
            /* 黄金细边 */
                    .balance-card::after { content: '';
                        position: absolute;
                        bottom: 0;
                        left: 0;
                        right: 0;
                        height: 2px;
                        background: linear-gradient(90deg, transparent, var(--gold-normal), transparent); }
            .balance-group { margin-bottom: clamp(10px, 2.5vw, 12px); }
            .balance-group:last-child { margin-bottom: 0; }
            .balance-label { font-size: clamp(12px, 3vw, 13px);
                        color: var(--text-sub);
                        margin-bottom: clamp(4px, 1vw, 6px);
                        transition: all 0.3s ease; }
            .balance-amount { font-size: clamp(24px, 6vw, 28px);
                        font-weight: 800;
                        background: linear-gradient(90deg, var(--gold-normal), #eed49b, var(--gold-light));
                        -webkit-background-clip: text;
                        -webkit-text-fill-color: transparent;
                        background-clip: text;
                        letter-spacing: -0.5px;
                        display: inline;
                        transition: all 0.3s ease; }
            .balance-amount.secondary { font-size: clamp(16px, 4vw, 18px);
                        font-weight: 600;
                        opacity: 0.7; }
            .balance-amount.primary { font-size: clamp(24px, 6vw, 28px);
                        font-weight: 800;
                        opacity: 1; }
            .balance-divider { height: 1px;
                        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
                        margin: clamp(8px, 2vw, 10px) 0; }
            /* 白色操作卡片 */
                    .white-card { background: var(--white-card);
                        border-radius: clamp(16px, 4vw, 18px);
                        border: 1px solid #EBE6DF;
                        box-shadow: 0 8px 18px rgba(0,0,0,.15);
                        padding: clamp(16px, 4vw, 20px);
                        margin-bottom: clamp(12px, 3vw, 16px); }
            .card-title { font-size: clamp(14px, 3.5vw, 16px);
                        font-weight: 600;
                        color: var(--text-dark);
                        margin-bottom: clamp(12px, 3vw, 16px); }
            /* 支付方式选择 */
                    .payment-options { display: grid;
                        grid-template-columns: 1fr 1fr;
                        gap: clamp(10px, 2.5vw, 12px);
                        margin-bottom: clamp(16px, 4vw, 20px); }
            .payment-option { position: relative;
                        padding: clamp(16px, 4vw, 20px) clamp(12px, 3vw, 14px);
                        background: #fff;
                        border: 2px solid #E5E0D8;
                        border-radius: clamp(12px, 3vw, 14px);
                        cursor: pointer;
                        transition: all 0.25s ease;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        gap: clamp(8px, 2vw, 10px); }
            .payment-option.active { background: linear-gradient(135deg, rgba(232, 201, 145, 0.12), rgba(248, 231, 193, 0.08));
                        border-color: var(--gold-normal);
                        box-shadow: 0 0 0 3px rgba(232, 201, 145, 0.15); }
            .payment-icon { width: clamp(32px, 8vw, 40px);
                        height: clamp(32px, 8vw, 40px);
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        position: relative;
                        flex-shrink: 0; }
            .payment-icon img { width: 100%;
                        height: 100%;
                        object-fit: contain; }
            /* 银行卡图标稍大 */
                    #pay-bank .payment-icon img { width: 110%;
                        height: 110%; }
            .payment-badge { position: absolute;
                        top: -4px;
                        right: -4px;
                        width: clamp(16px, 4vw, 18px);
                        height: clamp(16px, 4vw, 18px);
                        background: linear-gradient(135deg, #26A17B, #1E8A68);
                        border-radius: 50%;
                        border: 2px solid #fff;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        font-size: clamp(10px, 2.5vw, 11px);
                        font-weight: 700;
                        color: #fff;
                        box-shadow: 0 2px 6px rgba(38, 161, 123, 0.4); }
            .payment-name { font-size: clamp(14px, 3.5vw, 15px);
                        font-weight: 600;
                        color: var(--text-dark); }
            /* 表单组 */
                    .form-group { margin-bottom: clamp(14px, 3.5vw, 16px); }
            .form-label { display: block;
                        font-size: clamp(13px, 3.2vw, 14px);
                        font-weight: 600;
                        color: var(--text-dark);
                        margin-bottom: clamp(8px, 2vw, 10px); }
            .form-input { width: 100%;
                        height: clamp(48px, 12vw, 54px);
                        padding: 0 clamp(14px, 3.5vw, 16px);
                        background: #fff;
                        border: 1.5px solid #D4C9B8;
                        border-radius: clamp(14px, 3.5vw, 16px);
                        font-size: clamp(16px, 4vw, 18px);
                        font-weight: 600;
                        color: var(--text-dark);
                        outline: none;
                        transition: all 0.3s ease;
                        box-shadow: inset 0 1px 3px rgba(0,0,0,.05); }
            .form-input::placeholder { color: var(--text-muted);
                        font-weight: 400; }
            .form-input:focus { border-color: var(--gold-deep);
                        box-shadow: 0 0 0 3px rgba(232, 201, 145, 0.15); }
            /* 快捷金额 */
                    .quick-amounts { display: grid;
                        grid-template-columns: repeat(4, 1fr);
                        gap: clamp(8px, 2vw, 10px);
                        margin-top: clamp(10px, 2.5vw, 12px); }
            .quick-btn { padding: clamp(10px, 2.5vw, 12px);
                        background: #fff;
                        border: 1.5px solid #D4C9B8;
                        border-radius: clamp(10px, 2.5vw, 12px);
                        font-size: clamp(14px, 3.5vw, 15px);
                        font-weight: 600;
                        color: var(--text-dark);
                        cursor: pointer;
                        transition: all 0.2s ease; }
            .quick-btn:active { transform: scale(0.96);
                        background: linear-gradient(135deg, rgba(232, 201, 145, 0.15), rgba(248, 231, 193, 0.1));
                        border-color: var(--gold-normal); }
            /* 主按钮 */
                    .submit-btn { width: 100%;
                        height: clamp(50px, 12.5vw, 56px);
                        background: linear-gradient(135deg, #F3D49A, #E2B76A);
                        border: none;
                        border-radius: clamp(26px, 6.5vw, 28px);
                        font-size: clamp(16px, 4vw, 17px);
                        font-weight: 700;
                        color: #2B1B05;
                        cursor: pointer;
                        box-shadow: 0 4px 12px rgba(0,0,0,.20);
                        transition: all 0.2s ease;
                        margin-top: clamp(6px, 1.5vw, 8px); }
            .submit-btn:active { transform: scale(0.98);
                        box-shadow: 0 2px 8px rgba(0,0,0,.15); }
            /* 说明卡片 */
                    .tips-card { background: rgba(28, 47, 77, 0.4);
                        border: 1px solid rgba(232, 201, 145, 0.2);
                        border-radius: clamp(14px, 3.5vw, 16px);
                        padding: clamp(14px, 3.5vw, 16px);
                        margin-bottom: clamp(12px, 3vw, 16px); }
            .tips-title { font-size: clamp(13px, 3.2vw, 14px);
                        font-weight: 600;
                        color: var(--text-main);
                        margin-bottom: clamp(8px, 2vw, 10px);
                        display: flex;
                        align-items: center;
                        gap: clamp(6px, 1.5vw, 8px); }
            .tips-list { list-style: none;
                        padding: 0; }
            .tips-item { font-size: clamp(12px, 3vw, 13px);
                        color: var(--text-sub);
                        line-height: 1.6;
                        margin-bottom: clamp(6px, 1.5vw, 8px);
                        padding-left: clamp(14px, 3.5vw, 16px);
                        position: relative; }
            .tips-item::before { content: '•';
                        position: absolute;
                        left: 0;
                        color: var(--gold-normal); }
            .tips-item:last-child { margin-bottom: 0; }
            /* 上传凭证 */
                    .upload-section { margin-top: clamp(14px, 3.5vw, 16px);
                        padding-top: clamp(14px, 3.5vw, 16px);
                        border-top: 1px solid #E5E0D8; }
            .upload-label { font-size: clamp(13px, 3.2vw, 14px);
                        font-weight: 600;
                        color: var(--text-dark);
                        margin-bottom: clamp(10px, 2.5vw, 12px);
                        display: flex;
                        align-items: center;
                        gap: clamp(6px, 1.5vw, 8px); }
            .upload-area { position: relative;
                        width: 100%;
                        height: clamp(120px, 30vw, 140px);
                        background: #fff;
                        border: 2px dashed #D4C9B8;
                        border-radius: clamp(12px, 3vw, 14px);
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        justify-content: center;
                        cursor: pointer;
                        transition: all 0.3s ease;
                        overflow-y: auto; }
            .upload-area:hover { border-color: var(--gold-normal);
                        background: rgba(232, 201, 145, 0.05); }
            .upload-icon { font-size: clamp(32px, 8vw, 40px);
                        margin-bottom: clamp(8px, 2vw, 10px); }
            .upload-text { font-size: clamp(13px, 3.2vw, 14px);
                        color: var(--text-muted);
                        text-align: center; }
            .upload-preview { width: 100%;
                        height: 100%;
                        object-fit: cover;
                        display: none; }
            .upload-preview.show { display: block; }
            .upload-remove { position: absolute;
                        top: clamp(8px, 2vw, 10px);
                        right: clamp(8px, 2vw, 10px);
                        width: clamp(28px, 7vw, 32px);
                        height: clamp(28px, 7vw, 32px);
                        background: rgba(198, 61, 61, 0.95);
                        border-radius: 50%;
                        display: none;
                        align-items: center;
                        justify-content: center;
                        color: #fff;
                        font-size: clamp(16px, 4vw, 18px);
                        cursor: pointer;
                        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
                        z-index: 10; }
            .upload-remove.show { display: flex; }
            .upload-hint { font-size: clamp(11px, 2.8vw, 12px);
                        color: var(--text-muted);
                        margin-top: clamp(6px, 1.5vw, 8px);
                        text-align: center; }
            /* USDT地址显示区 */
                    .usdt-address-section { display: none;
                        margin-top: clamp(14px, 3.5vw, 16px);
                        padding: clamp(14px, 3.5vw, 16px);
                        background: linear-gradient(135deg, rgba(38, 161, 123, 0.08), rgba(38, 161, 123, 0.05));
                        border: 1.5px solid rgba(38, 161, 123, 0.3);
                        border-radius: clamp(12px, 3vw, 14px); }
            .usdt-address-section.show { display: block; }
            .address-label { font-size: clamp(12px, 3vw, 13px);
                        color: var(--text-dark);
                        font-weight: 600;
                        margin-bottom: clamp(8px, 2vw, 10px);
                        display: flex;
                        align-items: center;
                        justify-content: space-between;
                        gap: clamp(10px, 2.5vw, 12px); }
            .address-title { display: flex;
                        align-items: center;
                        gap: clamp(6px, 1.5vw, 8px); }
            .address-content { background: #fff;
                        border: 1px solid rgba(38, 161, 123, 0.2);
                        border-radius: clamp(10px, 2.5vw, 12px);
                        padding: clamp(12px, 3vw, 14px); }
            .address-text { font-size: clamp(13px, 3.2vw, 14px);
                        color: var(--text-dark);
                        font-weight: 400;
                        word-break: break-all;
                        line-height: 1.6;
                        letter-spacing: 0.3px; }
            .address-text .bold { font-weight: 700;
                        color: #1E8A68; }
            .copy-btn { flex-shrink: 0;
                        padding: clamp(4px, 1vw, 5px) clamp(10px, 2.5vw, 12px);
                        background: linear-gradient(135deg, #26A17B, #1E8A68);
                        border: none;
                        border-radius: clamp(6px, 1.5vw, 8px);
                        color: #fff;
                        font-size: clamp(11px, 2.8vw, 12px);
                        font-weight: 600;
                        cursor: pointer;
                        transition: all 0.2s ease; }
            .copy-btn:active { transform: scale(0.95); }
            .status-badge { display: inline-block;
                        padding: clamp(4px, 1vw, 5px) clamp(10px, 2.5vw, 12px);
                        border-radius: clamp(6px, 1.5vw, 8px);
                        font-size: clamp(11px, 2.8vw, 12px);
                        font-weight: 600; }
            .status-success { background: #E7F8EC;
                        color: #168F4B; }
            .status-pending { background: #FFF5DB;
                        color: #C78B1F; }
            .status-failed { background: #FFEAEA;
                        color: #C63D3D; }
            /* 底部弹窗 */
                    .popup-overlay { inset: 0;
                        background: rgba(0,0,0,.55);
                        z-index: 200;
                        display: none;
                        align-items: flex-end; }
            .popup-overlay.show { display: flex;
                        animation: fadeIn 0.3s ease; }
            @keyframes fadeIn { from { opacity: 0; }
            to { opacity: 1;; transform: translateY(0); }
            }

                    .popup-content { width: 100%;
                        max-height: 28vh;
                        background: #fff;
                        border-radius: clamp(18px, 4.5vw, 20px) clamp(18px, 4.5vw, 20px) 0 0;
                        padding: clamp(20px, 5vw, 24px);
                        animation: rise 0.35s cubic-bezier(0.4, 0, 0.2, 1); }
            @keyframes rise { from { transform: translateY(100%); }
            }

                    @keyframes shake { 0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-4px); }
            75% { transform: translateX(4px); }
            }

                    .popup-content.shake { animation: shake 0.3s ease; }
            .popup-title { font-size: clamp(16px, 4vw, 18px);
                        font-weight: 700;
                        color: var(--text-dark);
                        text-align: center;
                        margin-bottom: clamp(16px, 4vw, 20px); }
            .password-input { width: 100%;
                        height: clamp(50px, 12.5vw, 56px);
                        padding: 0 clamp(16px, 4vw, 20px);
                        background: #F8F6F2;
                        border: 2px solid #D4C9B8;
                        border-radius: clamp(14px, 3.5vw, 16px);
                        font-size: clamp(18px, 4.5vw, 20px);
                        font-weight: 600;
                        color: var(--text-dark);
                        text-align: center;
                        letter-spacing: clamp(4px, 1vw, 6px);
                        outline: none; }
            /* 小屏优化 */
                    @media (max-height: 700px) { .balance-card { padding: clamp(16px, 4vw, 20px) clamp(14px, 3.5vw, 16px); }
            .white-card { padding: clamp(14px, 3.5vw, 16px); }
            .popup-content { max-height: 26vh; padding: clamp(16px, 4vw, 18px); }
        </style>
    </head>
    <body>
        <!-- 顶部导航已删除，使用 app.html 的统一 header -->

        <!-- 内容区 -->
        <div class="content">
            <!-- 余额卡片 -->
            <div class="balance-card">
                <div class="balance-group" id="balanceGroup1">
                    <div class="balance-label" id="label1">人民币</div>
                    <div>
                        <span class="balance-amount primary" id="amount1">¥0.00</span>
                    </div>
                </div>
                <div class="balance-divider"></div>
                <div class="balance-group" id="balanceGroup2">
                    <div class="balance-label" id="label2">USDT</div>
                    <div>
                        <span class="balance-amount secondary" id="amount2">$0.0000</span>
                    </div>
                </div>
            </div>

            <!-- 白色操作卡片 -->
            <div class="white-card">
                <div class="card-title">选择充值方式</div>
                <div class="payment-options">
                    <div class="payment-option active" onclick="selectPayment('bank')" id="pay-bank">
                        <div class="payment-icon">
                            <img src="tp/yh.jpg" alt="银行卡" />
                        </div>
                        <div class="payment-name">银行卡</div>
                    </div>
                    <div class="payment-option" onclick="selectPayment('usdt')" id="pay-usdt">
                        <div class="payment-icon">
                            <img src="tp/rencyLogo.jpg" alt="USDT" />
                            <span class="payment-badge">🎁</span>
                        </div>
                        <div class="payment-name">USDT</div>
                    </div>
                    <div class="payment-option" onclick="selectPayment('wechat')" id="pay-wechat">
                        <div class="payment-icon">
                            <img src="tp/shouyintaitupian-39291220_3.jpg" alt="微信扫码" />
                        </div>
                        <div class="payment-name">微信扫码</div>
                    </div>
                    <div class="payment-option" onclick="selectPayment('alipay')" id="pay-alipay">
                        <div class="payment-icon">
                            <img src="tp/shouyintaitupian-39291220_31.jpg" alt="支付宝" />
                        </div>
                        <div class="payment-name">支付宝</div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">充值金额</label>
                    <input type="tel" class="form-input" id="amount" placeholder="请输入充值金额" autocomplete="off" />
                </div>

                <!-- USDT地址显示区 -->
                <div class="usdt-address-section" id="usdtAddressSection">
                    <div class="address-label">
                        <div class="address-title">
                            <span>💰</span>
                            <span>USDT充值地址 (TRC20)</span>
                        </div>
                        <button class="copy-btn" onclick="copyAddress()">复制</button>
                    </div>
                    <div class="address-content">
                        <div class="address-text" id="usdtAddress">加载中...</div>
                    </div>
                </div>

                <!-- 上传凭证 -->
                <div class="upload-section">
                    <div class="upload-label">
                        <span>📎</span>
                        <span>上传支付凭证</span>
                    </div>
                    <div class="upload-area" onclick="document.getElementById('receiptFile').click()">
                        <input
                            type="file"
                            id="receiptFile"
                            accept="image/*"
                            style="display: none"
                            onchange="handleFileSelect(event)"
                        />
                        <img id="receiptPreview" class="upload-preview" alt="凭证预览" />
                        <div class="upload-remove" id="removeBtn" onclick="removeReceipt(event)">×</div>
                        <div id="uploadPlaceholder">
                            <div class="upload-icon">📷</div>
                            <div class="upload-text">点击上传支付凭证<br />支持 JPG、PNG 格式</div>
                        </div>
                    </div>
                    <div class="upload-hint">建议上传清晰的转账截图或付款凭证</div>
                </div>

                <!-- 支付二维码显示区域（微信/支付宝） -->
                <div
                    class="qr-code-section"
                    id="qrCodeSection"
                    style="display: none; margin-top: 16px; text-align: center"
                >
                    <div class="card-title">请使用手机扫码支付</div>
                    <div
                        style="
                            background: #fff;
                            padding: 20px;
                            border-radius: 12px;
                            display: inline-block;
                            margin: 16px 0;
                        "
                    >
                        <img id="qrCodeImage" src="" alt="支付二维码" style="max-width: 200px; height: auto" />
                    </div>
                    <div style="font-size: 13px; color: var(--text-dark); margin-top: 12px">
                        <p>订单号: <span id="orderNoDisplay"></span></p>
                        <p>支付金额: <span id="payAmountDisplay"></span></p>
                    </div>
                    <button
                        class="submit-btn"
                        onclick="checkPaymentStatus()"
                        style="margin-top: 16px; background: linear-gradient(135deg, #26a17b, #1e8a68)"
                    >
                        我已支付，查询订单
                    </button>
                </div>

                <button class="submit-btn" onclick="confirmRecharge()" id="submitBtn">提交</button>
            </div>

            <!-- 说明卡片 -->
            <div class="tips-card">
                <div class="tips-title">
                    <span>💡</span>
                    <span>充值说明</span>
                </div>
                <ul class="tips-list">
                    <li class="tips-item">银行卡充值最低 ¥100，实时到账</li>
                    <li class="tips-item">USDT充值最低 10 USDT，链上确认 5-15 分钟，享 0.2% 奖励</li>
                    <li class="tips-item">微信扫码：最低 ¥100，最高 ¥3000，支付成功后自动到账</li>
                    <li class="tips-item">支付宝：最低 ¥100，最高 ¥20000，支付成功后自动到账</li>
                    <li class="tips-item">充值需要输入支付密码验证身份（银行卡/USDT）</li>
                    <li class="tips-item">如需修改绑定卡号或地址，请联系客服</li>
                </ul>
            </div>
        </div>

        <!-- 支付密码弹窗 -->
        <div class="popup-overlay" id="passwordPopup">
            <div class="popup-content" id="popupContent">
                <div class="popup-title">输入支付密码</div>
                <input
                    type="tel"
                    class="password-input"
                    id="payPassword"
                    placeholder="请输入6位支付密码"
                    maxlength="6"
                    inputmode="numeric"
                />
                <button class="submit-btn" onclick="submitRecharge()">确认</button>
            </div>
        </div>

        <!-- 引入MD5加密库 -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
        <script src="js/globals.js?v=1763253764"></script>
        <script src="config.js?v=1763254847"></script>
        <script src="js/payment-config.js?v=1763254847"></script>
        <script src="ios-toast.js?v=1763254847b227"></script>

        <!-- JS错误捕获，防止无限重载 -->
        <script>
            window.onerror = function (msg, url, line, col, error) {
                console.warn('⚠️ JS错误已捕获，已阻止页面跳回!!', msg);
                return true; // 阻止默认处理（阻止跳转 app.html）
            };

            // 防止未定义函数导致无限跳转
            if (typeof loadUsdtAddress !== 'function') {
                window.loadUsdtAddress = function () {
                    console.log('✅ loadUsdtAddress 已自动补齐（已废弃）');
                };
            }
        </script>

        <script>
            let selectedMethod = 'bank';
            let rechargeAmount = 0;
            let receiptImage = null;
            let usdtAddress = '';
            let clientIp = '';
            let currentOrderNo = '';
            let paymentCheckInterval = null;
            let balances = {
                cny: 0,
                usdt: 0,
            };

            function goBack() {
                window.location.href = 'profile.html';
            }

            document.addEventListener('DOMContentLoaded', async function () {
                if (!ApiService.auth.ensureLogin()) return;
                loadBalance();
                // loadUsdtAddress(); // 已移除，使用系统配置的USDT地址
                await loadClientIp();
            });

            async function loadClientIp() {
                try {
                    const response = await fetch('https://api.frevix.top/api/system/client-ip.php', {
                        method: 'GET',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                    });
                    const result = await response.json();
                    if (result.code === 1 && result.data && result.data.ip) {
                        clientIp = result.data.ip;
                        console.log('🌐 获取到用户IP:', clientIp);
                    } else {
                        console.warn('⚠️ 获取用户IP失败:', result);
                    }
                } catch (error) {
                    console.error('获取客户端IP失败:', error);
                }
            }

            async function loadBalance() {
                try {
                    const res = await ApiService.finance.getUserBalance();
                    if (res.code === 1 && res.data) {
                        balances.cny = parseFloat(res.data.balance || 0);
                        balances.usdt = parseFloat(res.data.usdt_balance || 0);
                        updateBalanceDisplay();
                    }
                } catch (e) {
                    console.error('加载余额失败:', e);
                }
            }

            // USDT地址相关函数已移除，使用新的支付接口

            function updateBalanceDisplay() {
                const label1 = document.getElementById('label1');
                const label2 = document.getElementById('label2');
                const amount1 = document.getElementById('amount1');
                const amount2 = document.getElementById('amount2');

                if (selectedMethod === 'usdt') {
                    // USDT 在上 - 大字号
                    label1.textContent = 'USDT';
                    amount1.textContent = '$' + balances.usdt.toFixed(4);
                    amount1.classList.remove('secondary');
                    amount1.classList.add('primary');

                    label2.textContent = '人民币';
                    amount2.textContent = '¥' + balances.cny.toFixed(2);
                    amount2.classList.add('secondary');
                    amount2.classList.remove('primary');
                } else {
                    // CNY 在上 - 大字号
                    label1.textContent = '人民币';
                    amount1.textContent = '¥' + balances.cny.toFixed(2);
                    amount1.classList.remove('secondary');
                    amount1.classList.add('primary');

                    label2.textContent = 'USDT';
                    amount2.textContent = '$' + balances.usdt.toFixed(4);
                    amount2.classList.add('secondary');
                    amount2.classList.remove('primary');
                }
            }

            function selectPayment(method) {
                selectedMethod = method;
                document.querySelectorAll('.payment-option').forEach(el => el.classList.remove('active'));
                document.getElementById('pay-' + method).classList.add('active');

                // 切换余额显示顺序
                updateBalanceDisplay();

                // 显示/隐藏 USDT 地址区域
                const usdtSection = document.getElementById('usdtAddressSection');
                if (method === 'usdt') {
                    usdtSection.classList.add('show');
                } else {
                    usdtSection.classList.remove('show');
                }

                // 显示/隐藏支付二维码区域
                const qrSection = document.getElementById('qrCodeSection');
                if (method === 'wechat' || method === 'alipay') {
                    qrSection.style.display = 'none';
                } else {
                    qrSection.style.display = 'none';
                }

                // 显示/隐藏上传凭证区域
                const uploadSection = document.querySelector('.upload-section');
                if (method === 'wechat' || method === 'alipay') {
                    uploadSection.style.display = 'none';
                } else {
                    uploadSection.style.display = 'block';
                }

                // 更新输入框占位符
                const amountInput = document.getElementById('amount');
                if (method === 'usdt') {
                    amountInput.placeholder = '请输入充值 USDT 数量';
                } else if (method === 'wechat' || method === 'alipay') {
                    const channelConfig = PAYMENT_CONFIG.channels[method];
                    if (channelConfig) {
                        amountInput.placeholder = `请输入充值金额（${channelConfig.minAmount}-${channelConfig.maxAmount}元）`;
                    } else {
                        amountInput.placeholder = '请输入充值金额';
                    }
                } else {
                    amountInput.placeholder = '请输入充值金额';
                }

                // 银行卡充值提示
                if (method === 'bank') {
                    showToast('提示', '请联系客服咨询充值账号');
                }
            }

            function handleFileSelect(event) {
                const file = event.target.files[0];
                if (!file) return;

                if (!file.type.match('image.*')) {
                    showToast('', '请选择图片文件');
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    showToast('', '图片大小不能超过5MB');
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    receiptImage = e.target.result;
                    document.getElementById('receiptPreview').src = e.target.result;
                    document.getElementById('receiptPreview').classList.add('show');
                    document.getElementById('uploadPlaceholder').style.display = 'none';
                    document.getElementById('removeBtn').classList.add('show');
                };
                reader.readAsDataURL(file);
            }

            function removeReceipt(event) {
                event.stopPropagation();
                receiptImage = null;
                document.getElementById('receiptFile').value = '';
                document.getElementById('receiptPreview').classList.remove('show');
                document.getElementById('uploadPlaceholder').style.display = 'block';
                document.getElementById('removeBtn').classList.remove('show');
            }

            async function confirmRecharge() {
                const amount = parseFloat(document.getElementById('amount').value);

                if (!amount) {
                    showToast('', '请输入充值金额');
                    return;
                }

                // 微信/支付宝支付
                if (selectedMethod === 'wechat' || selectedMethod === 'alipay') {
                    // 验证金额范围
                    const channelConfig = PAYMENT_CONFIG.channels[selectedMethod];
                    if (!channelConfig) {
                        showToast('', '不支持的支付方式');
                        return;
                    }

                    if (amount < channelConfig.minAmount) {
                        showToast('', `${channelConfig.name}最低${channelConfig.minAmount}元`);
                        return;
                    }

                    if (amount > channelConfig.maxAmount) {
                        showToast('', `${channelConfig.name}最高${channelConfig.maxAmount}元`);
                        return;
                    }

                    rechargeAmount = amount;

                    // 生成订单号
                    currentOrderNo = 'ORDER' + Date.now() + Math.random().toString(36).substr(2, 9).toUpperCase();

                    try {
                        // 显示加载提示
                        const submitBtn = document.getElementById('submitBtn');
                        submitBtn.disabled = true;
                        submitBtn.textContent = '创建订单中...';

                        // 创建支付订单
                        // 注意：根据 SevenPay 文档，所有金额单位均是元，需要提供用户IP、订单标题、订单描述
                        if (!clientIp) {
                            await loadClientIp();
                        }

                        const result = await createPayment({
                            amount: amount, // 金额单位是元（文档明确说明）
                            channel: selectedMethod,
                            orderNo: currentOrderNo,
                            notifyUrl: 'https://api.frevix.top/api/payment/notify.php',
                            returnUrl: 'https://frevix.top/recharge-success.html',
                            // IP 必填：优先使用后端接口获取的真实用户IP；若获取失败则使用占位IP
                            ip: clientIp || '0.0.0.0',
                            title: `充值订单-${amount}元`,
                            describe: `用户充值${amount}元`,
                        });

                        // 检查响应格式（根据文档：code=1成功，code=0失败）
                        if (result.code === 1 && result.data) {
                            // 显示支付链接（根据文档：data.payUrl）
                            if (result.data.payUrl) {
                                // 如果是二维码链接，显示二维码
                                if (result.data.payUrl.includes('qr') || result.data.payUrl.includes('qrcode')) {
                                    showPaymentQRCode(result.data.payUrl, currentOrderNo, amount);
                                } else {
                                    // 如果是支付链接，打开新窗口
                                    window.open(result.data.payUrl, '_blank');
                                    showToast('', '已打开支付页面，请完成支付');
                                }
                            } else {
                                console.error('❌ 支付响应数据异常:', result);
                                showToast('', '支付订单创建失败：缺少支付链接');
                            }
                        } else {
                            // 显示详细错误信息
                            const errorMsg = result.message || result.msg || '创建支付订单失败';
                            console.error('❌ 支付订单创建失败:', {
                                code: result.code,
                                message: errorMsg,
                                data: result,
                            });
                            showToast('', errorMsg);
                        }
                    } catch (error) {
                        console.error('创建支付订单失败:', error);
                        showToast('', error.message || '网络错误，请重试');
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.textContent = '提交';
                    }
                    return;
                }

                // 原有的银行卡/USDT充值流程
                if (selectedMethod === 'bank' && amount < 100) {
                    showToast('', '银行卡充值最低100元');
                    return;
                }

                if (selectedMethod === 'usdt' && amount < 10) {
                    showToast('', 'USDT充值最低10 USDT');
                    return;
                }

                if (!receiptImage) {
                    showToast('', '请上传支付凭证');
                    return;
                }

                rechargeAmount = amount;
                document.getElementById('passwordPopup').classList.add('show');

                // 延迟聚焦以确保弹窗完全显示
                setTimeout(() => {
                    document.getElementById('payPassword').focus();
                }, 300);
            }

            async function submitRecharge() {
                const pwd = document.getElementById('payPassword').value.trim();

                if (!pwd || pwd.length !== 6) {
                    const popup = document.getElementById('popupContent');
                    popup.classList.add('shake');
                    setTimeout(() => popup.classList.remove('shake'), 300);
                    showToast('', '请输入6位支付密码');
                    return;
                }

                try {
                    const res = await ApiService.finance.recharge({
                        amount: rechargeAmount,
                        pay_password: pwd,
                        payment_method: selectedMethod,
                        receipt_image: receiptImage,
                    });

                    if (res.code === 1) {
                        closePopup();
                        showToast('', '充值申请已提交，请等待审核');
                        document.getElementById('amount').value = '';
                        document.getElementById('payPassword').value = '';
                        removeReceipt(new Event('click'));
                        loadBalance();
                    } else {
                        showToast('', res.message || '充值失败');
                    }
                } catch (e) {
                    showToast('', '网络错误，请重试');
                }
            }

            function closePopup() {
                document.getElementById('passwordPopup').classList.remove('show');
                document.getElementById('payPassword').value = '';
            }

            function showPaymentQRCode(qrCode, orderNo, amount) {
                // 隐藏表单，显示二维码
                document.querySelector('.white-card .form-group').style.display = 'none';
                document.getElementById('usdtAddressSection').style.display = 'none';
                document.querySelector('.upload-section').style.display = 'none';
                document.getElementById('submitBtn').style.display = 'none';
                document.querySelector('.payment-options').style.display = 'none';

                // 显示二维码区域
                const qrSection = document.getElementById('qrCodeSection');
                qrSection.style.display = 'block';
                document.getElementById('qrCodeImage').src = qrCode;
                document.getElementById('orderNoDisplay').textContent = orderNo;
                document.getElementById('payAmountDisplay').textContent = '¥' + amount.toFixed(2);

                // 开始轮询查询订单状态
                startPaymentStatusCheck(orderNo);
            }

            function startPaymentStatusCheck(orderNo) {
                // 每5秒查询一次订单状态
                paymentCheckInterval = setInterval(async () => {
                    try {
                        const result = await queryPayment(orderNo);
                        if (result.code === 200 || result.code === 1 || result.code === '200' || result.code === '1') {
                            if (result.data && (result.data.status === 'paid' || result.data.status === 'success')) {
                                // 支付成功 - 通知后端
                                clearInterval(paymentCheckInterval);
                                await notifyBackendPaymentSuccess(orderNo, result.data);
                            }
                        }
                    } catch (error) {
                        console.error('查询订单状态失败:', error);
                    }
                }, 5000);
            }

            /**
             * 通知后端支付成功
             * @param {string} orderNo - 订单号
             * @param {Object} paymentData - 支付数据
             */
            async function notifyBackendPaymentSuccess(orderNo, paymentData) {
                try {
                    console.log('📤 通知后端支付成功:', { orderNo, paymentData });

                    // 调用后端API记录充值订单
                    const res = await ApiService.finance.recharge({
                        amount: rechargeAmount,
                        pay_password: '', // 第三方支付不需要支付密码
                        payment_method: selectedMethod, // 'wechat' 或 'alipay'
                        receipt_image: '', // 第三方支付不需要凭证
                        order_no: orderNo, // 第三方订单号
                        third_party_order: JSON.stringify(paymentData), // 第三方支付数据
                    });

                    if (res.code === 1) {
                        showToast('', '支付成功！余额已更新');
                        // 刷新余额
                        await loadBalance();
                        setTimeout(() => {
                            window.location.href = 'profile.html';
                        }, 1500);
                    } else {
                        console.error('❌ 后端记录订单失败:', res);
                        showToast('', '支付成功，但记录订单失败，请联系客服');
                    }
                } catch (error) {
                    console.error('❌ 通知后端支付成功失败:', error);
                    showToast('', '支付成功，但同步订单失败，请联系客服');
                }
            }

            async function checkPaymentStatus() {
                if (!currentOrderNo) {
                    showToast('', '订单号不存在');
                    return;
                }

                try {
                    const result = await queryPayment(currentOrderNo);
                    if (result.code === 200 || result.code === 1 || result.code === '200' || result.code === '1') {
                        if (result.data && (result.data.status === 'paid' || result.data.status === 'success')) {
                            // 支付成功 - 通知后端
                            await notifyBackendPaymentSuccess(currentOrderNo, result.data);
                        } else {
                            showToast('', '订单未支付，请完成支付');
                        }
                    } else {
                        showToast('', result.msg || result.message || '查询失败');
                    }
                } catch (error) {
                    console.error('查询订单状态失败:', error);
                    showToast('', '查询失败，请重试');
                }
            }

            // 页面卸载时清理定时器
            window.addEventListener('beforeunload', function () {
                if (paymentCheckInterval) {
                    clearInterval(paymentCheckInterval);
                }
            });

            document.getElementById('passwordPopup').addEventListener('click', function (e) {
                if (e.target === this) closePopup();
            });

            document.getElementById('payPassword').addEventListener('keypress', function (e) {
                if (e.key === 'Enter') submitRecharge();
            });
        </script>

        <link rel="stylesheet" href="css/iframe-fix.css" />
        <script src="js/swipe-back.js"></script>
        <script src="js/memory-leak-fix.js"></script>
        <script src="ios-toast.js"></script>
        <script src="custom-modal.js"></script>
    </body>
</html>
