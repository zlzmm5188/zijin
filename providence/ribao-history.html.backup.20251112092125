<script>
// ==========================================
// 页面2: ribao-history.html - 日利宝明细
// ==========================================

console.log('📜 日利宝明细页初始化');

function waitForAPI() {
    return new Promise((resolve) => {
        if (window.API_CONFIG) resolve();
        else {
            const check = setInterval(() => {
                if (window.API_CONFIG) {
                    clearInterval(check);
                    resolve();
                }
            }, 50);
            setTimeout(() => { clearInterval(check); resolve(); }, 3000);
        }
    });
}

async function loadRecords() {
    try {
        await waitForAPI();
        
        const token = localStorage.getItem('providence_token');
        if (!token) {
            console.warn('⚠️ 未登录');
            showEmptyState();
            return;
        }
        
        const API_BASE = window.API_CONFIG?.baseURL || 'https://api.frevix.top';
        const url = `${API_BASE}/user/ribao/records`;
        
        console.log('📡 请求日利宝记录:', url);
        
        const res = await fetch(url, {
            headers: { 'token': token }
        });
        const data = await res.json();
        
        console.log('📦 日利宝记录响应:', data);
        
        if ((data.code === 1 || data.code === 200) && data.data) {
            renderRecords(data.data);
        } else {
            console.error('❌ API错误:', data.message);
            showEmptyState();
        }
    } catch (error) {
        console.error('❌ 加载记录失败:', error);
        showEmptyState();
    }
}

function renderRecords(records) {
    const container = document.getElementById('recordList');
    if (!container) {
        console.error('❌ 未找到记录容器');
        return;
    }
    
    if (!records || records.length === 0) {
        showEmptyState();
        return;
    }
    
    container.innerHTML = '';
    
    records.forEach(record => {
        const item = document.createElement('div');
        item.className = 'record-item';
        
        const type = record.type === 'in' ? '转入' : '转出';
        const typeClass = record.type === 'in' ? 'type-in' : 'type-out';
        const amountPrefix = record.type === 'in' ? '+' : '-';
        
        const header = document.createElement('div');
        header.className = 'record-header';
        header.innerHTML = '<span class="record-type ' + typeClass + '">' + type + '</span><span class="record-time">' + formatDate(record.created_at) + '</span>';
        
        const body = document.createElement('div');
        body.className = 'record-body';
        body.innerHTML = '<span class="record-amount">' + amountPrefix + '¥' + parseFloat(record.amount || 0).toFixed(2) + '</span><span class="record-status">' + getStatusText(record.status) + '</span>';
        
        item.appendChild(header);
        item.appendChild(body);
        container.appendChild(item);
    });
    
    console.log('✅ 已渲染', records.length, '条记录');
}

function showEmptyState() {
    const container = document.getElementById('recordList');
    if (container) {
        const emptyDiv = document.createElement('div');
        emptyDiv.style.cssText = 'padding:60px 20px;text-align:center;color:#94a3b8;';
        emptyDiv.innerHTML = '<div style="font-size:48px;margin-bottom:16px;">📝</div><div style="font-size:16px;">暂无记录</div>';
        container.innerHTML = '';
        container.appendChild(emptyDiv);
    }
}

function formatDate(dateStr) {
    if (!dateStr) return '';
    const date = new Date(dateStr);
    const now = new Date();
    const diff = now - date;
    const hours = diff / (1000 * 60 * 60);
    
    if (hours < 24) {
        return date.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
    } else {
        return date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
    }
}

function getStatusText(status) {
    const statusMap = {
        '0': '处理中',
        '1': '成功',
        '-1': '失败'
    };
    return statusMap[status] || '未知';
}

document.addEventListener('DOMContentLoaded', function() {
    loadRecords();
});

console.log('✅ 日利宝明细页脚本加载完成');

