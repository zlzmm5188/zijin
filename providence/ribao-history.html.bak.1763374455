<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0, minimum-scale=1.0">
    <meta name="format-detection" content="telephone=no">
    <title>日利宝记录 - Providence</title>
    <link rel="stylesheet" href="styles.css?v=1763343791">
    <style>
        :root {
            --gold: #c8ba94;
            --green: #26A17B;
            --red: #E74C3C;
            --ink: #0f172a;
            --lineD: rgba(255,255,255,0.08);
        }

        * {
            -webkit-tap-highlight-color: transparent;
            -webkit-touch-callout: none;
        }

        html, body {
            color: rgba(255,255,255,0.85);
            -webkit-font-smoothing: antialiased;
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        body {
            background: linear-gradient(180deg, #0a1723 0%, #0f1c2a 100%) !important;
            padding-bottom: 65px !important;
            overflow-y: auto !important;
            -webkit-overflow-scrolling: touch;
        }

        /* 顶部导航 - 间距优化 */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 50;
            background: linear-gradient(180deg, rgba(10,23,35,.95), rgba(10,23,35,.75));
            backdrop-filter: blur(6px);
            padding: 12px 16px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--lineD);
            margin-bottom: 8px;
        }

        .back-btn {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: rgba(255,255,255,.08);
            color: #fff;
            font-size: 18px;
            text-decoration: none;
        }

        .brand h1 {
            margin: 0;
            font-size: 16px;
            color: #fff;
            font-weight: 600;
            flex: 1;
            text-align: center;
        }

        .spacer {
            width: 32px;
        }

        /* 筛选区域 - 间距8px */
        .filter-section {
            margin: 0 16px 8px;
            background: rgba(16, 27, 45, 0.92);
            border-radius: 12px;
            padding: 12px;
            border: 1px solid rgba(200, 186, 148, 0.3);
        }

        .filter-tabs {
            display: flex;
            gap: 6px;
            margin-bottom: 10px;
            background: rgba(255,255,255,0.03);
            padding: 4px;
            border-radius: 8px;
        }

        .filter-tab {
            flex: 1;
            padding: 8px;
            background: transparent;
            color: rgba(255,255,255,0.5);
            border: none;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .filter-tab.active {
            background: linear-gradient(135deg, #c8ba94 0%, #a39363 100%);
            color: #fff;
            font-weight: 600;
        }

        .filter-row {
            display: flex;
            gap: 8px;
        }

        .filter-input {
            flex: 1;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            padding: 8px 10px;
            color: #fff;
            font-size: 13px;
        }

        .filter-btn {
            background: linear-gradient(135deg, #c8ba94 0%, #a39363 100%);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        /* 记录列表 - 间距8px */
        .records-container {
            margin: 0 16px 16px;
        }

        .record-card {
            background: rgba(16, 27, 45, 0.92);
            border-radius: 12px;
            padding: 12px;
            border: 1px solid rgba(200, 186, 148, 0.2);
            margin-bottom: 8px;
        }

        .record-card:last-child {
            margin-bottom: 0;
        }

        .record-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .record-type {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            background: rgba(200, 186, 148, 0.15);
            border-radius: 6px;
            font-size: 12px;
            color: var(--gold);
            font-weight: 600;
        }

        .record-type.in {
            background: rgba(38, 161, 123, 0.15);
            color: var(--green);
        }

        .record-type.out {
            background: rgba(231, 76, 60, 0.15);
            color: var(--red);
        }

        .record-amount {
            font-size: 18px;
            font-weight: 700;
        }

        .record-amount.in {
            color: var(--green);
        }

        .record-amount.out {
            color: var(--red);
        }

        .record-currency {
            font-size: 12px;
            color: rgba(255,255,255,0.6);
            margin-left: 4px;
        }

        .record-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .record-balance {
            font-size: 12px;
            color: rgba(255,255,255,0.5);
        }

        .record-time {
            font-size: 12px;
            color: rgba(255,255,255,0.5);
        }

        /* 空状态 */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
        }

        .empty-icon {
            font-size: 48px;
            margin-bottom: 16px;
            opacity: 0.3;
        }

        .empty-text {
            color: rgba(255,255,255,0.5);
            font-size: 14px;
        }

        /* 加载更多 */
        .load-more {
            text-align: center;
            padding: 12px;
        }

        .load-more-btn {
            background: rgba(200, 186, 148, 0.15);
            color: var(--gold);
            border: 1px solid rgba(200, 186, 148, 0.3);
            border-radius: 8px;
            padding: 10px 32px;
            font-size: 14px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div class="topbar">
        <a href="javascript:history.back()" class="back-btn">←</a>
        <div class="brand"><h1>日利宝记录</h1></div>
        <div class="spacer"></div>
    </div>

    <div class="filter-section">
        <div class="filter-tabs">
            <button class="filter-tab active" onclick="filterByType('')">全部</button>
            <button class="filter-tab" onclick="filterByType('in')">转入</button>
            <button class="filter-tab" onclick="filterByType('out')">转出</button>
            <button class="filter-tab" onclick="filterByType('CNY')">人民币</button>
            <button class="filter-tab" onclick="filterByType('USDT')">USDT</button>
        </div>
        <div class="filter-row">
            <input type="date" class="filter-input" id="startDate" placeholder="开始日期">
            <input type="date" class="filter-input" id="endDate" placeholder="结束日期">
            <button class="filter-btn" onclick="applyDateFilter()">筛选</button>
        </div>
    </div>

    <div class="records-container" id="recordsContainer">
        <!-- 记录将通过JS动态加载 -->
    </div>

    <div class="load-more" id="loadMoreSection" style="display: none;">
        <button class="load-more-btn" onclick="loadMore()">加载更多</button>
    </div>

    <script src="config.js?v=1763365517"></script>
    <script src="ios-toast.js?v=17630668562427b227"></script>
    <script>
        let currentPage = 1;
        let totalPages = 1;
        let isLoading = false;
        let currentFilter = { type: '', currency: '' };

        // 右滑返回
        let touchStartX = 0;
        let touchEndX = 0;

        document.addEventListener('touchstart', e => {
            touchStartX = e.changedTouches[0].screenX;
        });

        document.addEventListener('touchend', e => {
            touchEndX = e.changedTouches[0].screenX;
            if (touchEndX - touchStartX > 100) {
                history.back();
            }
        });

        document.addEventListener('DOMContentLoaded', function() {
            if (!ApiService.auth.ensureLogin()) return;
            loadRecords();
        });

        async function loadRecords(page = 1) {
            if (isLoading) return;
            isLoading = true;

            try {
                const startDate = document.getElementById('startDate').value;
                const endDate = document.getElementById('endDate').value;

                const API_BASE = window.API_CONFIG?.baseURL || 'https://apis.copla.top;
                let url = `${API_BASE}/index.php/user/ribao/records?page=${page}&pageSize=20`;
                if (currentFilter.type) url += `&type=${currentFilter.type}`;
                if (startDate) url += `&start_date=${startDate}`;
                if (endDate) url += `&end_date=${endDate}`;

                const res = await fetch(url, {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                        'token': localStorage.getItem('providence_token') || localStorage.getItem('token') || ''
                    }
                });

                const result = await res.json();

                if ((result.code === 1 || result.code === 200) && result.data) {
                    const records = Array.isArray(result.data) ? result.data : (result.data.list || []);
                    const pagination = result.data.pagination || {};

                    currentPage = pagination.page || 1;
                    totalPages = pagination.pages || 1;

                    if (page === 1) {
                        displayRecords(records);
                    } else {
                        appendRecords(records);
                    }

                    const loadMoreSection = document.getElementById('loadMoreSection');
                    if (currentPage < totalPages) {
                        loadMoreSection.style.display = 'block';
                    } else {
                        loadMoreSection.style.display = 'none';
                    }
                } else {
                    if (page === 1) {
                        showEmptyState();
                    }
                }
            } catch (e) {
                console.error('加载记录失败:', e);
                showToast('', '加载失败，请稍后重试');
            } finally {
                isLoading = false;
            }
        }

        function displayRecords(records) {
            const container = document.getElementById('recordsContainer');

            if (records.length === 0) {
                showEmptyState();
                return;
            }

            container.innerHTML = records.map(record => {
                const typeClass = record.type;
                const typeText = record.type === 'in' ? '转入' : '转出';
                const typeIcon = record.type === 'in' ? '📥' : '📤';
                const amountSign = record.type === 'in' ? '+' : '-';
                const currencySymbol = record.currency === 'USDT' ? '$' : '¥';

                return `
                    <div class="record-card">
                        <div class="record-header">
                            <div class="record-type ${typeClass}">
                                <span>${typeIcon}</span>
                                <span>${typeText}</span>
                            </div>
                            <div class="record-amount ${typeClass}">
                                ${amountSign}${currencySymbol}${record.amount}
                                <span class="record-currency">${record.currency}</span>
                            </div>
                        </div>
                        <div class="record-footer">
                            <div class="record-balance">余额: ${currencySymbol}${record.after_balance}</div>
                            <div class="record-time">${record.date} ${record.time}</div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function appendRecords(records) {
            const container = document.getElementById('recordsContainer');
            const newHTML = records.map(record => {
                const typeClass = record.type;
                const typeText = record.type === 'in' ? '转入' : '转出';
                const typeIcon = record.type === 'in' ? '📥' : '📤';
                const amountSign = record.type === 'in' ? '+' : '-';
                const currencySymbol = record.currency === 'USDT' ? '$' : '¥';

                return `
                    <div class="record-card">
                        <div class="record-header">
                            <div class="record-type ${typeClass}">
                                <span>${typeIcon}</span>
                                <span>${typeText}</span>
                            </div>
                            <div class="record-amount ${typeClass}">
                                ${amountSign}${currencySymbol}${record.amount}
                                <span class="record-currency">${record.currency}</span>
                            </div>
                        </div>
                        <div class="record-footer">
                            <div class="record-balance">余额: ${currencySymbol}${record.after_balance}</div>
                            <div class="record-time">${record.date} ${record.time}</div>
                        </div>
                    </div>
                `;
            }).join('');
            container.insertAdjacentHTML('beforeend', newHTML);
        }

        function showEmptyState() {
            const container = document.getElementById('recordsContainer');
            container.innerHTML = `
                <div class="empty-state">
                    <div class="empty-icon">💰</div>
                    <div class="empty-text">暂无日利宝记录</div>
                </div>
            `;
        }

        function filterByType(filter) {
            if (filter === 'CNY' || filter === 'USDT') {
                currentFilter.currency = filter;
                currentFilter.type = '';
            } else {
                currentFilter.type = filter;
                currentFilter.currency = '';
            }
            currentPage = 1;

            document.querySelectorAll('.filter-tab').forEach(tab => tab.classList.remove('active'));
            event.target.classList.add('active');

            loadRecords(1);
        }

        function applyDateFilter() {
            currentPage = 1;
            loadRecords(1);
        }

        function loadMore() {
            loadRecords(currentPage + 1);
        }
    </script>
</body>
</html>
