    box-shadow:0 24px 48px rgba(0,0,0,0.25),0 0 0 1px rgba(0,0,0,0.05);
    animation:slideUp .3s ease;
    overflow:hidden;
}

@keyframes slideUp{
    from{
        opacity:0;
        transform:translateY(30px) scale(0.95);
    }
    to{
        opacity:1;
        transform:translateY(0) scale(1);
    }
}

