.product-header-compact{
    padding:14px 16px 10px;
    background:linear-gradient(135deg, #fffef7 0%, #ffffff 100%);
}

.product-title-compact{
    font-size:16px;
    font-weight:700;
    color:#1a1a1a;
    line-height:1.4;
    margin-bottom:4px;
    padding-right:60px;
    overflow:hidden;
    text-overflow:ellipsis;
