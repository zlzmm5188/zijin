/* 弹窗样式 */
.modal{
    position:fixed;
    top:0;
    left:0;
    right:0;
    bottom:0;
    z-index:9999;
    display:flex;
    align-items:center;
    justify-content:center;
    animation:fadeIn .3s ease;
}

@keyframes fadeIn{
    from{opacity:0;}
    to{opacity:1;}
}

.modal-overlay{
    position:absolute;
    top:0;
    left:0;
    right:0;
    bottom:0;
    background:rgba(0,0,0,0.6);
    backdrop-filter:blur(4px);
}

