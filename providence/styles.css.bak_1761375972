    }

    .data-icon{
        font-size:14px;
    }

    .btn-apply-compact{
        padding:8px 16px;
        font-size:13px;
    }
}

@media (min-width: 768px) {
    .product-list{
        max-width:600px;
        margin:0 auto;
    }
