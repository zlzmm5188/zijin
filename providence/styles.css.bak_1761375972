.expert-card:active{transform:translateY(2px);box-shadow:0 1px 4px rgba(0,0,0,.06)}
.expert-avatar{font-size:48px;margin-bottom:8px}
.expert-info{text-align:center}
.expert-name{font-size:14px;font-weight:700;color:#1a2332;margin-bottom:4px}
.expert-title{font-size:12px;color:#6c757d;margin-bottom:3px;line-height:1.3}
.expert-exp{font-size:11px;color:#94a3b8;font-weight:500}
/* 公司动态 */
.company-news{background:#fff;margin:0 0 12px;padding:12px 16px 20px}
.news-cards{display:flex;flex-direction:column;gap:12px}
.news-card{display:block;background:linear-gradient(135deg,#f8f9fa 0%,#fff 100%);border-radius:12px;padding:14px;text-decoration:none;border:1px solid rgba(0,0,0,.04);box-shadow:0 2px 8px rgba(0,0,0,.03);transition:transform .2s,box-shadow .2s}
